{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blogit-sample",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ASPNETCORE_URLS = \"http://localhost:$env:PORT\"; dotnet run --project samples/BlogIt.Sample/BlogIt.Sample.csproj --no-build --no-launch-profile"
      ],
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "autoPort": true,
      "port": 5107
    },
    {
      "name": "blogit-sample-inmemory",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ASPNETCORE_URLS = \"http://localhost:$env:PORT\"; dotnet run --project samples/BlogIt.Sample/BlogIt.Sample.csproj --no-build --no-launch-profile"
      ],
      "env": { "ASPNETCORE_ENVIRONMENT": "Testing" },
      "autoPort": true,
      "port": 5108
    },
    {
      "name": "ericjohansson-site",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "../EricJohansson.se/src/EricJohansson.Aspire/EricJohansson.Aspire.Host/EricJohansson.Aspire.Host.csproj",
        "--launch-profile",
        "http"
      ],
      "env": { "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true" },
      "port": 59463
    }
  ]
}
