@page "/account"
@inject MauiApiClient Api
@inject NavigationManager Nav
@inject SiteProfileService ProfileService

<div class="page-header">
    <h1 class="page-title">My Account</h1>
</div>

<div class="card" style="max-width:480px">
    <h2 class="card-title">Change Password</h2>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success">@_success</div>
    }

    <div class="form-group">
        <label>Current Password</label>
        <input class="form-control" type="password" @bind="_currentPassword" placeholder="Current password" />
    </div>

    <div class="form-group">
        <label>New Password</label>
        <input class="form-control" type="password" @bind="_newPassword" placeholder="New password" />
    </div>

    <div class="form-group">
        <label>Confirm New Password</label>
        <input class="form-control" type="password" @bind="_confirmPassword" placeholder="Confirm new password" />
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_saving">
            @(_saving ? "Saving…" : "Change Password")
        </button>
    </div>
</div>

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _saving;
    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        if (profile?.IsTokenValid != true) { Nav.NavigateTo("/login"); return; }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_currentPassword)) { _error = "Current password is required."; return; }
        if (string.IsNullOrWhiteSpace(_newPassword)) { _error = "New password is required."; return; }
        if (_newPassword != _confirmPassword) { _error = "New passwords do not match."; return; }
        if (_newPassword.Length < 6) { _error = "New password must be at least 6 characters."; return; }

        _saving = true;
        var ok = await Api.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
        _saving = false;

        if (ok)
        {
            _success = "Password changed successfully.";
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
        }
        else
        {
            _error = "Failed to change password. Check your current password and try again.";
        }
    }
}
