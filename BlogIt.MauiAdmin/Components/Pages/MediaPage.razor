@page "/media"
@using BlogIt.MauiAdmin.Services
@using BlogIt.Shared.DTOs
@inject MauiApiClient Api
@inject MediaCaptureService Capture
@inject SiteProfileService ProfileService
@inject NavigationManager Nav

<h1>Media Library</h1>

<div class="toolbar">
    <input class="form-control search-input" @bind="_search" @bind:event="oninput"
           placeholder="Search…" @onkeydown="OnSearchKey" />

    <div class="upload-actions">
        <button class="btn btn-primary" @onclick="PickFile">📁 Upload File</button>
        <button class="btn btn-primary" @onclick="PickPhoto">🖼 From Library</button>
        @if (IsAndroid || IsIos)
        {
            <button class="btn btn-primary" @onclick="CapturePhoto">📷 Camera</button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_uploadStatus))
{
    <div class="alert @(_uploadError ? "alert-danger" : "alert-success")">@_uploadStatus</div>
}

@if (_loading)
{
    <div class="loading">Loading media…</div>
}
else if (_media is null || _media.Items.Count == 0)
{
    <p class="empty-state">No media files yet. Upload something to get started.</p>
}
else
{
    <div class="media-grid">
        @foreach (var m in _media.Items)
        {
            <div class="media-card @(_selected?.Id == m.Id ? "media-card--selected" : "")"
                 @onclick="() => Select(m)">
                @if (m.ContentType.StartsWith("image/"))
                {
                    <img src="@(_activeBaseUrl + m.PublicPath)" alt="@m.Title" class="media-thumb" />
                }
                else
                {
                    <div class="media-icon">@GetFileIcon(m.ContentType)</div>
                }
                <div class="media-card__name">@m.Title</div>
            </div>
        }
    </div>

    <div class="pagination">
        @if (_page > 1)
        {
            <button class="btn btn-sm btn-secondary" @onclick="PrevPage">← Prev</button>
        }
        <span>Page @_page of @TotalPages</span>
        @if (_page < TotalPages)
        {
            <button class="btn btn-sm btn-secondary" @onclick="NextPage">Next →</button>
        }
    </div>

    @if (_selected is not null)
    {
        <div class="media-detail card">
            <h3>@_selected.Title</h3>
            @if (_selected.ContentType.StartsWith("image/"))
            {
                <img src="@(_activeBaseUrl + _selected.PublicPath)" alt="@_selected.Title"
                     style="max-width:300px;max-height:300px;object-fit:contain" />
            }
            <p><strong>Type:</strong> @_selected.ContentType</p>
            <p><strong>Size:</strong> @FormatSize(_selected.SizeBytes)</p>
            <p><strong>Uploaded:</strong> @_selected.UploadedAt.ToLocalTime().ToString("g")</p>
            <div class="form-group">
                <label>Public URL</label>
                <div class="input-copy">
                    <input class="form-control" readonly value="@(_activeBaseUrl + _selected.PublicPath)" />
                    <button class="btn btn-secondary" @onclick="CopyUrl">Copy</button>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-danger" @onclick="DeleteSelected">🗑 Delete</button>
            </div>
        </div>
    }
}

@code {
    private PagedResult<MediaFileDto>? _media;
    private MediaFileDto? _selected;
    private string _search = "";
    private int _page = 1;
    private bool _loading = true;
    private string? _uploadStatus;
    private bool _uploadError;
    private string _activeBaseUrl = "";

    private int TotalPages => _media is null ? 1 : (int)Math.Ceiling(_media.TotalCount / (double)_media.PageSize);

    private static bool IsAndroid =>
#if ANDROID
        true;
#else
        false;
#endif
    private static bool IsIos =>
#if IOS
        true;
#else
        false;
#endif

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        _activeBaseUrl = profile?.ApiBaseUrl.TrimEnd('/') ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _media = await Api.GetMediaAsync(_search, _page);
        _loading = false;
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private void Select(MediaFileDto m) =>
        _selected = _selected?.Id == m.Id ? null : m;

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task CapturePhoto() => await UploadFromCapture(await Capture.CapturePhotoAsync());
    private async Task PickPhoto() => await UploadFromCapture(await Capture.PickPhotoAsync());
    private async Task PickFile() => await UploadFromCapture(await Capture.PickFileAsync());

    private async Task UploadFromCapture(MediaCaptureService.CapturedMedia? captured)
    {
        if (captured is null) return;
        _uploadStatus = "Uploading…";
        _uploadError = false;
        StateHasChanged();

        var title = Path.GetFileNameWithoutExtension(captured.FileName);
        var result = await Api.UploadMediaAsync(title, captured.Data, captured.FileName, captured.ContentType);
        await captured.Data.DisposeAsync();

        if (result is not null)
        {
            _uploadStatus = $"✓ '{result.Title}' uploaded successfully.";
            _page = 1;
            await LoadAsync();
        }
        else
        {
            _uploadStatus = "Upload failed. Check your connection and try again.";
            _uploadError = true;
        }
    }

    private async Task DeleteSelected()
    {
        if (_selected is null) return;
        if (await Api.DeleteMediaAsync(_selected.Id))
        {
            _selected = null;
            await LoadAsync();
        }
    }

    private async Task CopyUrl()
    {
        if (_selected is null) return;
        await Clipboard.Default.SetTextAsync(_activeBaseUrl + _selected.PublicPath);
        _uploadStatus = "URL copied to clipboard.";
        _uploadError = false;
    }

    private static string GetFileIcon(string contentType) => contentType switch
    {
        var t when t.StartsWith("video/") => "🎬",
        var t when t.Contains("pdf") => "📕",
        var t when t.Contains("word") => "📝",
        _ => "📎"
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024} KB",
        _ => $"{bytes / (1024 * 1024):0.0} MB"
    };
}

