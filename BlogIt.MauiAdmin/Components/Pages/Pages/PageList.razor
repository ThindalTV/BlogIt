@page "/pages"
@inject MauiApiClient Api
@inject NavigationManager Nav
@inject SiteProfileService ProfileService

<div class="page-header">
    <h1 class="page-title">Pages</h1>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/pages/new")'>+ New Page</button>
</div>

<div class="toolbar">
    <input class="form-control" placeholder="Search pages…" @bind="_search" @bind:event="oninput"
           @onkeydown="OnSearchKey" style="max-width:300px" />
    <button class="btn btn-primary btn-sm" @onclick="LoadAsync">Search</button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else if (_result is not null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Slug</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var page in _result.Items)
            {
                <tr>
                    <td>@(page.Title)</td>
                    <td><code>@(page.Slug)</code></td>
                    <td>
                        @if (page.IsPublished)
                        {
                            <span class="badge badge-success">Published</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Draft</span>
                        }
                    </td>
                    <td class="table-actions">
                        <button class="btn btn-sm btn-outline"
                                @onclick="() => EditPage(page.Id)">Edit</button>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => ConfirmDelete(page.Id, page.Title)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (TotalPageCount > 1)
    {
        <div class="pagination">
            <button class="btn btn-sm btn-outline" disabled="@(_page <= 1)" @onclick="PrevPage">← Prev</button>
            <span>Page @_page of @TotalPageCount</span>
            <button class="btn btn-sm btn-outline" disabled="@(_page >= TotalPageCount)" @onclick="NextPage">Next →</button>
        </div>
    }
}

@if (_confirmDeleteId.HasValue)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog card">
            <p>Delete page "<strong>@_confirmDeleteTitle</strong>"? This cannot be undone.</p>
            <div class="confirm-actions">
                <button class="btn btn-danger" @onclick="DoDeleteAsync">Yes, Delete</button>
                <button class="btn btn-outline" @onclick="() => { _confirmDeleteId = null; }">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<PageDto>? _result;
    private string _search = "";
    private int _page = 1;
    private bool _loading = true;
    private string? _error;
    private Guid? _confirmDeleteId;
    private string? _confirmDeleteTitle;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        if (profile?.IsTokenValid != true) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _result = await Api.GetPagesAsync(_search, _page); }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private void ConfirmDelete(Guid id, string? title)
    {
        _confirmDeleteId = id;
        _confirmDeleteTitle = title;
    }

    private async Task DoDeleteAsync()
    {
        if (_confirmDeleteId is null) return;
        await Api.DeletePageAsync(_confirmDeleteId.Value);
        _confirmDeleteId = null;
        await LoadAsync();
    }

    private int TotalPageCount => _result is null ? 1 : (int)Math.Ceiling(_result.TotalCount / (double)_result.PageSize);

    private void EditPage(Guid id) => Nav.NavigateTo($"/pages/{id}");

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
