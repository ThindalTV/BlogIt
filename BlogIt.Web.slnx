<!-- The web/server half of the product: every project in BlogIt.slnx except the MAUI client,
     its Core library and its tests, which the path-filtered MAUI CI job builds instead.
     Kept in sync by SolutionCoverageTests. -->
<Solution>
  <Folder Name="/src/">
    <Project Path="src/BlogIt.Core/BlogIt.Core.csproj" />
    <Project Path="src/BlogIt.Contracts/BlogIt.Contracts.csproj" />
  </Folder>
  <Folder Name="/src/admin/">
    <Project Path="src/admin/BlogIt.Admin/BlogIt.Admin.csproj" />
  </Folder>
  <Folder Name="/src/providers/">
    <Project Path="src/providers/BlogIt.AzureStorage/BlogIt.AzureStorage.csproj" />
    <Project Path="src/providers/BlogIt.GoogleAnalytics/BlogIt.GoogleAnalytics.csproj" />
    <Project Path="src/providers/BlogIt.OpenAi/BlogIt.OpenAi.csproj" />
    <Project Path="src/providers/BlogIt.Sqlite/BlogIt.Sqlite.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/BlogIt.Tests/BlogIt.Tests.csproj" />
    <Project Path="tests/BlogIt.Contracts.Tests/BlogIt.Contracts.Tests.csproj" />
  </Folder>
  <Folder Name="/samples/">
    <Project Path="samples/BlogIt.Sample/BlogIt.Sample.csproj" />
    <Project Path="samples/BlogIt.Sample.AppHost/BlogIt.Sample.AppHost.csproj" />
    <Project Path="samples/BlogIt.Sample.ServiceDefaults/BlogIt.Sample.ServiceDefaults.csproj" />
  </Folder>
</Solution>
