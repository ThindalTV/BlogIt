@page "/"
@inject IPublicContentService ContentService
@inject BlogIt.Web.Services.ISettingsService SettingsService

<SeoHead Title="@siteName"
         Description="@siteDescription"
         CanonicalUrl="@siteUrl"
         OgType="website"
         SchemaType="SeoSchemaType.WebSite" />

<GaScript />

<section class="hero">
    <h1>@siteName</h1>
    @if (!string.IsNullOrEmpty(siteDescription))
    {
        <p class="hero-description">@siteDescription</p>
    }
</section>

<section class="post-list">
    <h2>Recent Posts</h2>
    @if (posts.Count == 0)
    {
        <p>No posts yet.</p>
    }
    else
    {
        @foreach (var post in posts)
        {
            <article class="post-card">
                <h3 class="post-title">
                    @if (post.HasFullContent)
                    {
                        <a href="@BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt)">@post.Title</a>
                    }
                    else
                    {
                        @post.Title
                    }
                </h3>
                <p class="post-meta">
                    <time datetime="@post.PublishedAt!.Value.ToString("yyyy-MM-dd")">
                        @post.PublishedAt!.Value.ToString("MMMM d, yyyy")
                    </time>
                </p>
                <div class="post-summary">@((MarkupString)MarkdownHelper.ToHtml(post.Summary))</div>
                @if (post.Tags.Any())
                {
                    <div class="tag-list">
                        @foreach (var tag in post.Tags)
                        {
                            <a class="tag-chip" href="/tags/@tag.Slug">@tag.Name</a>
                        }
                    </div>
                }
                @if (post.HasFullContent)
                {
                    <a class="read-more" href="@BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt)">Read more &rarr;</a>
                }
            </article>
        }
    }
</section>

@code {
    private IReadOnlyList<BlogPostSummaryDto> posts = [];
    private string siteName = "BlogIt";
    private string? siteDescription;
    private string? siteUrl;

    protected override async Task OnInitializedAsync()
    {
        siteName = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteName) ?? "BlogIt";
        siteDescription = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteDescription);
        siteUrl = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteUrl);

        posts = await ContentService.GetRecentPostsAsync(5);
    }
}
