<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
    <ProjectReference Include="..\..\src\BlogIt\BlogIt.csproj" />
    <!--
      The AI satellite, so this sample keeps demonstrating the admin's brainstorm and
      export-to-draft screens now that the OpenAI SDK is no longer part of the core package. The
      analytics satellite is deliberately NOT referenced: the sample substitutes its own
      IAnalyticsService (see ManualTestAnalyticsService.cs), which doubles as proof that a host can
      light up the dashboard panel without taking BlogIt.GoogleAnalytics or its prerelease
      Google SDK dependency.
    -->
    <ProjectReference Include="..\..\src\BlogIt.OpenAi\BlogIt.OpenAi.csproj" />
    <!-- Source builds need the bundled contracts assembly as a compile reference. The BlogIt package supplies it itself. -->
    <ProjectReference Include="..\..\src\BlogIt.Contracts\BlogIt.Contracts.csproj"
                      PrivateAssets="all" />
    <ProjectReference Include="..\BlogIt.Sample.ServiceDefaults\BlogIt.Sample.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0-preview.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlogIt.Sample</AssemblyName>
    <RootNamespace>BlogIt.Sample</RootNamespace>
    <UserSecretsId>BlogIt.Sample-67b54a46-833e-4c56-86c9-09a8d3cc1ee0</UserSecretsId>
  </PropertyGroup>

</Project>
