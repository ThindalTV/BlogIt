@page "/{Year:int}/{Slug}"
@inject IPublicContentService ContentService
@inject BlogIt.Services.ISettingsService SettingsService
@inject BlogIt.Services.IPreviewTokenService PreviewTokens
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

@if (post != null)
{
    @if (isPreview)
    {
        <HeadContent>
            <meta name="robots" content="noindex,nofollow" />
        </HeadContent>
        <div class="draft-preview-banner" role="status">
            <strong>DRAFT PREVIEW</strong>
            <span>This single-use preview does not publish the post.</span>
        </div>
    }
    <SeoHead Title="@(post.SeoTitle ?? post.Title)"
             Description="@(post.SeoDescription ?? post.Summary)"
             Keywords="@post.SeoKeywords"
             OgImage="@post.OgImageUrl"
             CanonicalUrl="@($"{siteUrl}{BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt)}")"
             OgType="article"
             SchemaType="@(isPreview ? SeoSchemaType.None : SeoSchemaType.BlogPosting)"
             StructuredDataName="@post.Title"
             AuthorName="@post.AuthorDisplayName"
             PublishedAt="@post.PublishedAt"
             ModifiedAt="@post.UpdatedAt" />
    @if (!isPreview)
    {
        <GaScript />
    }

    <article class="post-full">
        <header class="post-header">
            <h1>@post.Title</h1>
            <p class="post-meta">
                @if (isPreview)
                {
                    <span>Draft last updated @post.UpdatedAt.ToString("MMMM d, yyyy")</span>
                }
                else
                {
                    <time datetime="@post.PublishedAt!.Value.ToString("yyyy-MM-dd")">
                        @post.PublishedAt!.Value.ToString("MMMM d, yyyy")
                    </time>
                }
                @if (!string.IsNullOrEmpty(post.AuthorDisplayName))
                {
                    <span class="post-author"> · by @post.AuthorDisplayName</span>
                }
            </p>
            @if (post.Tags.Any())
            {
                <div class="tag-list">
                    @foreach (var tag in post.Tags)
                    {
                        <a class="tag-chip" href="/tags/@tag.Slug">@tag.Name</a>
                    }
                </div>
            }
        </header>

        <div class="post-content">
            @if (!string.IsNullOrEmpty(post.Content))
            {
                @((MarkupString)MarkdownHelper.ToHtml(post.Content))
            }
            else
            {
                <div class="post-summary">@((MarkupString)MarkdownHelper.ToHtml(post.Summary))</div>
                <p><em>This post is only available in the listing.</em></p>
            }
        </div>
    </article>

    @if (!isPreview)
    {
        <nav class="post-nav" aria-label="Post navigation">
        @if (prevPost != null)
        {
            <a class="post-nav-prev" href="@BlogUrlHelper.GetPostPath(prevPost.Slug, prevPost.PublishedAt, prevPost.CreatedAt)">&larr; @prevPost.Title</a>
        }
        @if (nextPost != null)
        {
            <a class="post-nav-next" href="@BlogUrlHelper.GetPostPath(nextPost.Slug, nextPost.PublishedAt, nextPost.CreatedAt)">@nextPost.Title &rarr;</a>
        }
        </nav>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public int? Year { get; set; }
    [SupplyParameterFromQuery(Name = "preview")] public Guid? Preview { get; set; }

    private BlogPostDetailDto? post;
    private BlogPostSummaryDto? prevPost;
    private BlogPostSummaryDto? nextPost;
    private string? siteUrl;
    private bool isPreview;

    protected override async Task OnInitializedAsync()
    {
        var content = await ContentService.GetPostAsync(
            Slug,
            includeNavigation: !Preview.HasValue);
        post = content?.Post;
        prevPost = content?.PreviousPost;
        nextPost = content?.NextPost;

        if (post is null)
        {
            MarkNotFound();
            return;
        }

        var expectedYear = BlogUrlHelper.GetYear(post.PublishedAt, post.CreatedAt);
        if (Preview.HasValue)
        {
            isPreview = Year == expectedYear
                && HttpContextAccessor.HttpContext is not null
                && PreviewTokens.TryAuthorize(
                    HttpContextAccessor.HttpContext,
                    Preview,
                    BlogIt.Services.PreviewContentType.Post,
                    post.Id);
            if (!isPreview)
            {
                post = null;
                MarkNotFound();
                return;
            }
        }
        else
        {
            if (!post.IsPublished || post.PublishedAt is null)
            {
                post = null;
                MarkNotFound();
                return;
            }

            if (Year != expectedYear)
            {
                Nav.NavigateTo(
                    BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt),
                    replace: true,
                    forceLoad: true);
                return;
            }
        }

        siteUrl = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteUrl) ?? "";
    }

    // Flags the request for NotFoundResponseMiddleware, which renders a real 404 with real HTML
    // afterward — see that class's remarks for why this isn't done directly here (both
    // HttpContext.Response.StatusCode = 404 and NavigationManager.NotFound() hit confirmed
    // framework issues in this pipeline).
    private void MarkNotFound() =>
        HttpContextAccessor.HttpContext?.Items[BlogIt.Sample.NotFoundResponseMiddleware.ItemKey] = true;
}
