@page "/{Slug}"
@inject IPublicContentService ContentService
@inject BlogIt.Services.ISettingsService SettingsService
@inject BlogIt.Services.IPreviewTokenService PreviewTokens
@inject IHttpContextAccessor HttpContextAccessor

@if (customPage != null)
{
    @if (isPreview)
    {
        <HeadContent>
            <meta name="robots" content="noindex,nofollow" />
        </HeadContent>
        <div class="draft-preview-banner" role="status">
            <strong>DRAFT PREVIEW</strong>
            <span>This single-use preview does not publish the page.</span>
        </div>
    }
    <SeoHead Title="@(customPage.SeoTitle ?? customPage.Title)"
             Description="@(customPage.SeoDescription)"
             Keywords="@(customPage.SeoKeywords)"
             OgImage="@(customPage.OgImageUrl)"
             CanonicalUrl="@($"{siteUrl}/{customPage.Slug}")"
             OgType="article"
             SchemaType="@(isPreview ? SeoSchemaType.None : SeoSchemaType.WebPage)"
             StructuredDataName="@customPage.Title" />
    @if (!isPreview)
    {
        <GaScript />
    }

    <article class="page-full">
        <header>
            <h1>@customPage.Title</h1>
        </header>
        <div class="page-content">
            @((MarkupString)MarkdownHelper.ToHtml(customPage.Content))
        </div>
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "preview")] public Guid? Preview { get; set; }

    private PageDto? customPage;
    private string? siteUrl;
    private bool isPreview;

    protected override async Task OnInitializedAsync()
    {
        customPage = await ContentService.GetPageAsync(Slug);

        if (customPage is null)
        {
            MarkNotFound();
            return;
        }

        if (Preview.HasValue)
        {
            isPreview = HttpContextAccessor.HttpContext is not null
                && PreviewTokens.TryAuthorize(
                HttpContextAccessor.HttpContext,
                Preview,
                BlogIt.Services.PreviewContentType.Page,
                customPage.Id);
            if (!isPreview)
            {
                customPage = null;
                MarkNotFound();
                return;
            }
        }
        else if (!customPage.IsPublished)
        {
            customPage = null;
            MarkNotFound();
            return;
        }

        siteUrl = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteUrl) ?? "";
    }

    // Flags the request for NotFoundResponseMiddleware, which renders a real 404 with real HTML
    // afterward — see that class's remarks for why this isn't done directly here (both
    // HttpContext.Response.StatusCode = 404 and NavigationManager.NotFound() hit confirmed
    // framework issues in this pipeline).
    private void MarkNotFound() =>
        HttpContextAccessor.HttpContext?.Items[BlogIt.Sample.NotFoundResponseMiddleware.ItemKey] = true;
}
