@page "/search"
@inject IPublicContentService ContentService
@inject BlogIt.Services.ISettingsService SettingsService

<SeoHead Title="@(string.IsNullOrWhiteSpace(Q) ? "Search" : $"Search: {Q}")"
         CanonicalUrl="@($"{siteUrl}/search")"
         SchemaType="SeoSchemaType.SearchResultsPage" />
<GaScript />

<h1>Search</h1>

<form class="search-form search-form-page" action="/search" method="get">
    <input type="search" name="q" value="@Q" placeholder="Search posts…" aria-label="Search" />
    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrWhiteSpace(Q))
{
    <p class="search-results-count">
        Page @Page of @totalPages for "<strong>@Q</strong>"
    </p>

    @if (results.Count == 0)
    {
        <p>No posts matched your search.</p>
    }
    else
    {
        @foreach (var post in results)
        {
            <article class="post-card">
                <h2 class="post-title">
                    @if (post.HasFullContent)
                    {
                        <a href="@BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt)">@post.Title</a>
                    }
                    else
                    {
                        @post.Title
                    }
                </h2>
                <p class="post-meta">
                    <time datetime="@post.PublishedAt!.Value.ToString("yyyy-MM-dd")">
                        @post.PublishedAt!.Value.ToString("MMMM d, yyyy")
                    </time>
                </p>
                <div class="post-summary">@((MarkupString)MarkdownHelper.ToHtml(post.Summary))</div>
                @if (post.Tags.Any())
                {
                    <div class="tag-list">
                        @foreach (var tag in post.Tags)
                        {
                            <a class="tag-chip" href="/tags/@tag.Slug">@tag.Name</a>
                        }
                    </div>
                }
                @if (post.HasFullContent)
                {
                    <a class="read-more" href="@BlogUrlHelper.GetPostPath(post.Slug, post.PublishedAt, post.CreatedAt)">Read more &rarr;</a>
                }
            </article>
        }

        <nav class="pagination" aria-label="Pagination">
            @if (Page > 1)
            {
                <a href="/search?q=@Q&page=@(Page - 1)" class="pagination-prev">&larr; Newer</a>
            }
            <span class="pagination-info">Page @Page of @totalPages</span>
            @if (Page < totalPages)
            {
                <a href="/search?q=@Q&page=@(Page + 1)" class="pagination-next">Older &rarr;</a>
            }
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;

    private const int PageSize = 10;
    private IReadOnlyList<BlogPostSummaryDto> results = [];
    private int totalPages = 1;
    private string? siteUrl;

    protected override async Task OnInitializedAsync()
    {
        if (Page < 1) Page = 1;

        siteUrl = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteUrl) ?? "";

        if (string.IsNullOrWhiteSpace(Q)) return;

        var resultPage = await ContentService.SearchPostsAsync(Q, Page, PageSize);
        Page = resultPage.Page;
        totalPages = resultPage.TotalPages;
        results = resultPage.Posts;
    }
}
