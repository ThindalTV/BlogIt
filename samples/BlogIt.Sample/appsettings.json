{
  // No ConnectionStrings:BlogItDb on purpose. This file used to commit a
  // "(localdb)\\mssqllocaldb;Trusted_Connection=True" default, which meant any run that had not been
  // configured — including a deployed one — silently started against machine-local SQL instead of
  // failing. Supply it per environment: BlogIt.Sample.AppHost injects it, and a standalone run can
  // use `dotnet user-secrets set ConnectionStrings:BlogItDb "..."` or the ConnectionStrings__BlogItDb
  // environment variable. See SampleDatabaseConnection.cs.
  "BlogIt": {
    "Storage": {
      "RootPath": "App_Data/blogit-media"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
