<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlogIt.Admin</AssemblyName>
    <RootNamespace>BlogIt.Admin</RootNamespace>
    <IsPackable>false</IsPackable>
    <StaticWebAssetBasePath>blogit</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BlogItBundledAdminBuild)' == 'true'">
    <OutputPath>$(BlogItAdminBuildRoot)bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BlogItAdminBuildRoot)obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-preview.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlogIt.Contracts\BlogIt.Contracts.csproj" />
  </ItemGroup>

</Project>
