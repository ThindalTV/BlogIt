@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject LocalStorageService LocalStorage

<div class="admin-shell">
    <header class="topbar">
        <button type="button" class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="Toggle navigation" aria-expanded="@sidebarOpen">
            <span class="sidebar-toggle-icon">☰</span>
        </button>
        <div class="topbar-brand">
            <span class="topbar-logo">✦</span>
            <span class="topbar-name">BlogIt Admin</span>
        </div>
    </header>

    <div class="admin-body">
        @if (sidebarOpen)
        {
            <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
        }
        <nav class="sidebar @(sidebarOpen ? "sidebar-open" : "")">
            <ul class="nav-list">
                <li><NavLink href="" Match="NavLinkMatch.All" class="nav-link"><span class="nav-icon">⊞</span>Dashboard</NavLink></li>
                <li><NavLink href="posts" class="nav-link"><span class="nav-icon">✎</span>Posts</NavLink></li>
                <li><NavLink href="pages" class="nav-link"><span class="nav-icon">☰</span>Pages</NavLink></li>
                <li><NavLink href="media" class="nav-link"><span class="nav-icon">🖼</span>Media</NavLink></li>
                <li><NavLink href="ai" class="nav-link"><span class="nav-icon">✦</span>AI</NavLink></li>
                <li><NavLink href="redirects" class="nav-link"><span class="nav-icon">↪</span>Redirects</NavLink></li>
                <li class="nav-divider"></li>
                <li><NavLink href="users" class="nav-link"><span class="nav-icon">👤</span>Users</NavLink></li>
                <li><NavLink href="settings" class="nav-link"><span class="nav-icon">⚙</span>Settings</NavLink></li>
                <li><NavLink href="account" class="nav-link"><span class="nav-icon">🔑</span>My Account</NavLink></li>
            </ul>
            <AuthorizeView>
                <Authorized>
                    <div class="sidebar-user">
                        <div class="sidebar-user-identity">
                            <span class="sidebar-user-icon">👤</span>
                            <span class="sidebar-username">@(context.User.Identity?.Name ?? "Admin")</span>
                        </div>
                        <button type="button" class="btn-logout" @onclick="Logout">Logout</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool sidebarOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!sidebarOpen) return;
        sidebarOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private void CloseSidebar() => sidebarOpen = false;

    private async Task Logout()
    {
        var provider = (AuthStateProvider)AuthProvider;
        await provider.MarkUserAsLoggedOut();
        Nav.NavigateTo("login", forceLoad: false);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
