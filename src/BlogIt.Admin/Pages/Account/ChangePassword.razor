@page "/account"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Change Password — BlogIt Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">My Account</h1>
</div>

<div class="form-card">
    <h2 class="form-card-title">Change Password</h2>

    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-error">@errorMsg</div>
    }
    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div class="alert alert-success">@successMsg</div>
    }

    <div class="form-group">
        <label class="form-label">Current Password</label>
        <input class="form-input" type="password" @bind="currentPassword" autocomplete="current-password" />
    </div>
    <div class="form-group">
        <label class="form-label">New Password</label>
        <input class="form-input" type="password" @bind="newPassword" autocomplete="new-password" />
    </div>
    <div class="form-group">
        <label class="form-label">Confirm New Password</label>
        <input class="form-input" type="password" @bind="confirmPassword" autocomplete="new-password" />
    </div>
    <button class="btn btn-primary" @onclick="Submit" disabled="@isSaving">
        @if (isSaving) { <span class="spinner-sm"></span> } else { <span>Change Password</span> }
    </button>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool isSaving;
    private string errorMsg = "";
    private string successMsg = "";

    private async Task Submit()
    {
        errorMsg = "";
        successMsg = "";
        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMsg = "All fields are required.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            errorMsg = "New passwords do not match.";
            return;
        }
        isSaving = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest(currentPassword, newPassword));
            currentPassword = newPassword = confirmPassword = "";

            // Changing the password moves the account's security stamp, which invalidates every
            // token signed before it — including the one this session is holding. Clearing it and
            // sending the user to the login screen is the honest end state; leaving them here
            // would show a logged-in shell where every request 401s.
            successMsg = "Password changed. Please sign in again with your new password.";
            await ((AuthStateProvider)AuthProvider).MarkUserAsLoggedOut();
            Nav.NavigateTo("login", forceLoad: false);
        }
        catch (Exception ex) { errorMsg = $"Failed: {ex.Message}"; }
        finally { isSaving = false; }
    }
}
