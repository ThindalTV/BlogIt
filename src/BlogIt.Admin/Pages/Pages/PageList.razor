@page "/pages"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Pages — BlogIt Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Pages</h1>
    <a class="btn btn-primary" href="pages/new">+ New Page</a>
</div>

<div class="toolbar">
    <input class="form-input toolbar-search" type="search" aria-label="Search pages"
           placeholder="Search pages…" value="@searchQuery" @oninput="OnSearchInput" />
</div>

@if (isLoading)
{
    <div class="loading-spinner-wrap"><div class="spinner"></div></div>
}
else if (result == null || result.Items.Count == 0)
{
    <div class="empty-state-box">
        @if (string.IsNullOrWhiteSpace(searchQuery))
        {
            <p>No pages yet.</p>
            <a class="btn btn-primary" href="pages/new">Create your first page</a>
        }
        else
        {
            <p>No pages match “@searchQuery”.</p>
        }
    </div>
}
else
{
    <p class="list-summary">@RangeSummary()</p>

    <table class="data-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Slug</th>
                <th>Status</th>
                <th>Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pg in result.Items)
            {
                <tr>
                    <td><a href="pages/@pg.Id">@pg.Title</a></td>
                    <td><code>@pg.Slug</code></td>
                    <td>
                        <span class="badge @(pg.IsPublished ? "badge-published" : "badge-draft")">@ScheduleLabel(pg)</span>
                        @if (pg.ScheduledPublishAt.HasValue || pg.ScheduledUnpublishAt.HasValue)
                        {
                            <div class="form-hint">@ScheduleTime(pg)</div>
                        }
                    </td>
                    <td>@pg.UpdatedAt.ToString("MMM d, yyyy")</td>
                    <td class="actions">
                        <a class="btn btn-sm btn-secondary" href="pages/@pg.Id">Edit</a>
                        <button class="btn btn-sm btn-secondary" @onclick="() => Preview(pg)">Preview</button>
                        @if (pg.ScheduledPublishAt.HasValue || pg.ScheduledUnpublishAt.HasValue)
                        {
                            <button class="btn btn-sm btn-secondary" @onclick="() => ClearSchedule(pg)">Cancel schedule</button>
                        }
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(pg)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager CurrentPage="currentPage"
           TotalCount="result.TotalCount"
           PageSize="result.PageSize"
           OnPageChanged="LoadPages" />
}

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-error">@errorMsg</div>
}

<ConfirmDialog IsOpen="showConfirm"
    Title="Delete Page"
    Message=@($"Delete \"{pageToDelete?.Title}\"? This cannot be undone.")
    OnConfirm="DeletePage"
    OnCancel="() => showConfirm = false" />

@code {
    private PagedResult<PageDto>? result;
    private bool isLoading = true;
    private int currentPage = 1;
    private string searchQuery = "";
    private string errorMsg = "";
    private bool showConfirm;
    private PageDto? pageToDelete;

    protected override async Task OnInitializedAsync() => await LoadPages(1);

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        // Back to page 1: the old page number means nothing against a different result set, and
        // the search runs server-side so it is not limited to the rows already on screen.
        await LoadPages(1);
    }

    private async Task LoadPages(int page)
    {
        isLoading = true;
        currentPage = page;
        errorMsg = "";
        try { result = await Api.GetPagesAsync(searchQuery, page); }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isLoading = false; }
    }

    /// <summary>Reloads the current page, dropping back a page when deleting emptied the last one.</summary>
    private async Task ReloadAfterMutation()
    {
        var page = currentPage;
        if (result is not null && result.Items.Count == 1 && page > 1)
            page--;
        await LoadPages(page);
    }

    private string RangeSummary()
    {
        if (result is null || result.Items.Count == 0) return "";
        var from = ((currentPage - 1) * result.PageSize) + 1;
        return $"{from}–{from + result.Items.Count - 1} of {result.TotalCount}";
    }

    private void ConfirmDelete(PageDto page) { pageToDelete = page; showConfirm = true; }

    private async Task Preview(PageDto page)
    {
        try
        {
            var preview = await Api.CreatePagePreviewAsync(page.Id);
            if (preview is not null)
                Nav.NavigateTo(preview.Url, forceLoad: true);
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private async Task ClearSchedule(PageDto page)
    {
        try
        {
            await Api.UpdatePageScheduleAsync(page.Id, new(null, null));
            await LoadPages(currentPage);
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private static string ScheduleLabel(PageDto page) => page.ScheduleState switch
    {
        PublicationScheduleState.ScheduledForPublishing => "Scheduled",
        PublicationScheduleState.ScheduledForUnpublishing => "Published · scheduled",
        PublicationScheduleState.Published => "Published",
        _ => "Draft"
    };

    private static string ScheduleTime(PageDto page)
    {
        var instant = page.ScheduleState == PublicationScheduleState.ScheduledForPublishing
            ? page.ScheduledPublishAt
            : page.ScheduledUnpublishAt;
        return instant.HasValue ? instant.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "";
    }

    private async Task DeletePage()
    {
        showConfirm = false;
        if (pageToDelete == null) return;
        try { await Api.DeletePageAsync(pageToDelete.Id); await ReloadAfterMutation(); }
        catch (Exception ex) { errorMsg = ex.Message; }
    }
}
