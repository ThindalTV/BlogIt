@page "/settings"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Settings — BlogIt Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Site Settings</h1>
    <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
        @if (isSaving) { <span class="spinner-sm"></span> } else { <span>Save Settings</span> }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-error">@errorMsg</div>
}
@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success">@successMsg</div>
}

@if (isLoading)
{
    <div class="loading-spinner-wrap"><div class="spinner"></div></div>
}
else
{
    <div class="settings-sections">
        <div class="settings-section">
            <h2 class="settings-section-title">Site</h2>
            <div class="form-group">
                <label class="form-label" for="settings-site-name">Site Name</label>
                <input id="settings-site-name" class="form-input" @bind="siteName" />
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-site-url">Site URL</label>
                <input id="settings-site-url" class="form-input" @bind="siteUrl" />
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-site-description">Description</label>
                <textarea id="settings-site-description" class="form-textarea" @bind="siteDescription" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-og-image">Default OG Image URL</label>
                <input id="settings-og-image" class="form-input" @bind="defaultOgImage" />
            </div>
        </div>

        <div class="settings-section">
            <h2 class="settings-section-title">AI</h2>
            <div class="form-group">
                <label class="form-label" for="settings-ai-provider">Provider</label>
                <select id="settings-ai-provider" class="form-select" @bind="aiProvider">
                    <option value="github-copilot">GitHub Copilot</option>
                    <option value="openai-compatible">OpenAI-Compatible</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-ai-key">API Key <span class="form-hint">(leave blank to keep existing)</span></label>
                <input id="settings-ai-key" class="form-input" type="password" @bind="aiApiKey" placeholder="****" autocomplete="off" />
            </div>
            @if (aiProvider == "openai-compatible")
            {
                <div class="form-group">
                    <label class="form-label" for="settings-ai-base-url">Base URL</label>
                    <input id="settings-ai-base-url" class="form-input" @bind="aiBaseUrl" placeholder="https://api.openai.com/v1" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="settings-ai-model">Model</label>
                    <input id="settings-ai-model" class="form-input" @bind="aiModel" placeholder="gpt-4o" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="settings-ai-export-model">Export Model</label>
                    <input id="settings-ai-export-model" class="form-input" @bind="aiExportModel" />
                </div>
            }
        </div>

        <div class="settings-section">
            <h2 class="settings-section-title">Analytics</h2>
            <div class="form-group">
                <label class="form-label" for="settings-ga-measurement-id">Measurement ID</label>
                <input id="settings-ga-measurement-id" class="form-input" @bind="gaMeasurementId" placeholder="G-XXXXXXXXXX" />
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-ga-property-id">Property ID</label>
                <input id="settings-ga-property-id" class="form-input" @bind="gaPropertyId" placeholder="123456789" />
            </div>
            <div class="form-group">
                <label class="form-label" for="settings-ga-credentials">Service Account Credentials JSON <span class="form-hint">(leave blank to keep existing)</span></label>
                <textarea id="settings-ga-credentials" class="form-textarea" @bind="gaCredentialsJson" rows="5" placeholder="****"></textarea>
            </div>
        </div>

        <div class="settings-section">
            <h2 class="settings-section-title">Auth</h2>
            <div class="form-group">
                <label class="form-label" for="settings-jwt-expiry">JWT Expiry (minutes)</label>
                <input id="settings-jwt-expiry" class="form-input" type="number" @bind="jwtExpiryMinutes" min="5" max="10080" />
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSaving;
    private string errorMsg = "";
    private string successMsg = "";

    private string siteName = "";
    private string siteUrl = "";
    private string siteDescription = "";
    private string defaultOgImage = "";
    private string aiProvider = "github-copilot";
    private string aiApiKey = "";
    private string aiBaseUrl = "";
    private string aiModel = "";
    private string aiExportModel = "";
    private string gaMeasurementId = "";
    private string gaPropertyId = "";
    private string gaCredentialsJson = "";
    private int jwtExpiryMinutes = 60;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Api.GetSettingsAsync();
            if (settings != null)
            {
                siteName = settings.GetValueOrDefault(SettingKeys.SiteName, "");
                siteUrl = settings.GetValueOrDefault(SettingKeys.SiteUrl, "");
                siteDescription = settings.GetValueOrDefault(SettingKeys.SiteDescription, "");
                defaultOgImage = settings.GetValueOrDefault(SettingKeys.DefaultOgImage, "");
                aiProvider = settings.GetValueOrDefault(SettingKeys.AiProvider, "github-copilot");
                aiBaseUrl = settings.GetValueOrDefault(SettingKeys.AiBaseUrl, "");
                aiModel = settings.GetValueOrDefault(SettingKeys.AiModel, "");
                aiExportModel = settings.GetValueOrDefault(SettingKeys.AiExportModel, "");
                gaMeasurementId = settings.GetValueOrDefault(SettingKeys.GoogleAnalyticsMeasurementId, "");
                gaPropertyId = settings.GetValueOrDefault(SettingKeys.GoogleAnalyticsPropertyId, "");
                if (int.TryParse(settings.GetValueOrDefault(SettingKeys.JwtExpiryMinutes, "60"), out var exp))
                    jwtExpiryMinutes = exp;
            }
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isLoading = false; }
    }

    private async Task Save()
    {
        isSaving = true;
        errorMsg = "";
        successMsg = "";

        if (!IsValidAbsoluteHttpUrl(siteUrl))
        {
            errorMsg = "Site URL must be an absolute http:// or https:// URL.";
            isSaving = false;
            return;
        }

        try
        {
            // Secrets stay null unless the user actually retyped one this session — null means
            // "leave unchanged", so a blank field can never blank out a stored credential.
            var settings = new SiteSettingsUpdateRequest(
                SiteName: siteName,
                SiteUrl: siteUrl,
                SiteDescription: siteDescription,
                DefaultOgImage: defaultOgImage,
                AiProvider: aiProvider,
                AiBaseUrl: aiBaseUrl,
                AiModel: aiModel,
                AiExportModel: aiExportModel,
                AiApiKey: string.IsNullOrWhiteSpace(aiApiKey) ? null : aiApiKey,
                GoogleAnalyticsMeasurementId: gaMeasurementId,
                GoogleAnalyticsPropertyId: gaPropertyId,
                GoogleAnalyticsCredentialsJson: string.IsNullOrWhiteSpace(gaCredentialsJson) ? null : gaCredentialsJson,
                JwtExpiryMinutes: jwtExpiryMinutes);

            await Api.UpdateSettingsAsync(settings);
            successMsg = "Settings saved.";
            aiApiKey = gaCredentialsJson = "";
        }
        catch (Exception ex) { errorMsg = $"Save failed: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private static bool IsValidAbsoluteHttpUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
}
