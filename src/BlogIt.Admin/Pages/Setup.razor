@page "/setup"
@layout BlogIt.Admin.Layout.LoginLayout
@inject ApiClient Api
@inject NavigationManager Nav

<div class="setup-page">
    <div class="setup-card">
        <div class="setup-header">
            <span class="login-logo">✦</span>
            <h1>BlogIt Setup</h1>
            <p>First-run configuration wizard</p>
        </div>

        <div class="wizard-steps">
            @for (int i = 1; i <= 4; i++)
            {
                var step = i;
                <div class="wizard-step @(step == currentStep ? "active" : step < currentStep ? "done" : "")">
                    <span class="step-num">@(step < currentStep ? "✓" : step.ToString())</span>
                    <span class="step-label">@StepLabel(step)</span>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-error">@errorMsg</div>
        }

        @if (currentStep == 1)
        {
            <div class="wizard-section">
                <h2>Admin Account</h2>
                <div class="form-group">
                    <label class="form-label" for="setup-username">Username</label>
                    <input id="setup-username" class="form-input" @bind="model.Username" placeholder="admin" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-display-name">Display Name</label>
                    <input id="setup-display-name" class="form-input" @bind="model.DisplayName" placeholder="Admin User" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-password">Password</label>
                    <input id="setup-password" class="form-input" type="password" @bind="model.Password" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-confirm-password">Confirm Password</label>
                    <input id="setup-confirm-password" class="form-input" type="password" @bind="confirmPassword" />
                </div>
            </div>
        }
        else if (currentStep == 2)
        {
            <div class="wizard-section">
                <h2>Site Information</h2>
                <div class="form-group">
                    <label class="form-label" for="setup-site-name">Site Name</label>
                    <input id="setup-site-name" class="form-input" @bind="model.SiteName" placeholder="My Blog" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-site-url">Site URL</label>
                    <input id="setup-site-url" class="form-input" @bind="model.SiteUrl" placeholder="https://example.com" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-site-description">Description</label>
                    <textarea id="setup-site-description" class="form-textarea" @bind="model.SiteDescription" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-og-image">Default OG Image URL <span class="form-hint">(optional)</span></label>
                    <input id="setup-og-image" class="form-input" @bind="model.DefaultOgImage" placeholder="https://example.com/og.png" />
                </div>
            </div>
        }
        else if (currentStep == 3)
        {
            <div class="wizard-section">
                <h2>AI Provider</h2>
                <div class="form-group">
                    <label class="form-label" for="setup-ai-provider">Provider</label>
                    <select id="setup-ai-provider" class="form-select" @bind="model.AiProvider">
                        <option value="github-copilot">GitHub Copilot</option>
                        <option value="openai-compatible">OpenAI-Compatible</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-ai-key">API Key</label>
                    <input id="setup-ai-key" class="form-input" type="password" @bind="model.AiApiKey" placeholder="sk-…" />
                </div>
                @if (model.AiProvider == "openai-compatible")
                {
                    <div class="form-group">
                        <label class="form-label" for="setup-ai-base-url">Base URL</label>
                        <input id="setup-ai-base-url" class="form-input" @bind="model.AiBaseUrl" placeholder="https://api.openai.com/v1" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="setup-ai-model">Model</label>
                        <input id="setup-ai-model" class="form-input" @bind="model.AiModel" placeholder="gpt-4o" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="setup-ai-export-model">Export Model <span class="form-hint">(optional, for draft export)</span></label>
                        <input id="setup-ai-export-model" class="form-input" @bind="model.AiExportModel" placeholder="gpt-4o" />
                    </div>
                }
            </div>
        }
        else if (currentStep == 4)
        {
            <div class="wizard-section">
                <h2>Google Analytics <span class="form-hint">(optional)</span></h2>
                <div class="form-group">
                    <label class="form-label" for="setup-ga-measurement-id">Measurement ID</label>
                    <input id="setup-ga-measurement-id" class="form-input" @bind="model.GoogleAnalyticsMeasurementId" placeholder="G-XXXXXXXXXX" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-ga-property-id">Property ID</label>
                    <input id="setup-ga-property-id" class="form-input" @bind="model.GoogleAnalyticsPropertyId" placeholder="123456789" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="setup-ga-credentials">Service Account Credentials JSON</label>
                    <textarea id="setup-ga-credentials" class="form-textarea" @bind="model.GoogleAnalyticsCredentialsJson" rows="6" placeholder='{"type":"service_account",…}'></textarea>
                </div>
            </div>
        }

        <div class="wizard-nav">
            @if (currentStep > 1)
            {
                <button class="btn btn-secondary" @onclick="PrevStep">← Back</button>
            }
            else
            {
                <span></span>
            }
            @if (currentStep < 4)
            {
                <button class="btn btn-primary" @onclick="NextStep">Next →</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Submit" disabled="@isSubmitting">
                    @if (isSubmitting) { <span class="spinner-sm"></span> } else { <span>Finish Setup</span> }
                </button>
            }
        </div>
    </div>
</div>

@code {
    private SetupModel model = new();
    private string confirmPassword = "";
    private int currentStep = 1;
    private bool isSubmitting;
    private string errorMsg = "";

    protected override async Task OnInitializedAsync()
    {
        var status = await Api.GetSetupStatusAsync();
        if (status?.IsComplete == true)
            Nav.NavigateTo("login", replace: true);
    }

    private string StepLabel(int step) => step switch
    {
        1 => "Account",
        2 => "Site Info",
        3 => "AI",
        4 => "Analytics",
        _ => ""
    };

    private void NextStep()
    {
        errorMsg = "";
        if (currentStep == 1)
        {
            if (string.IsNullOrWhiteSpace(model.Username)) { errorMsg = "Username is required."; return; }
            if (string.IsNullOrWhiteSpace(model.Password)) { errorMsg = "Password is required."; return; }
            if (model.Password != confirmPassword) { errorMsg = "Passwords do not match."; return; }
        }
        else if (currentStep == 2)
        {
            if (string.IsNullOrWhiteSpace(model.SiteName)) { errorMsg = "Site name is required."; return; }
            if (!IsValidAbsoluteHttpUrl(model.SiteUrl)) { errorMsg = "Site URL must be an absolute http:// or https:// URL."; return; }
        }
        currentStep++;
    }

    private void PrevStep() => currentStep--;

    private static bool IsValidAbsoluteHttpUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private async Task Submit()
    {
        isSubmitting = true;
        errorMsg = "";
        try
        {
            await Api.InitializeAsync(new SetupInitializeRequest(
                model.Username, model.DisplayName, model.Password,
                model.SiteName, model.SiteUrl, model.SiteDescription, model.DefaultOgImage,
                model.AiProvider, model.AiApiKey, model.AiBaseUrl, model.AiModel, model.AiExportModel,
                model.GoogleAnalyticsMeasurementId, model.GoogleAnalyticsPropertyId, model.GoogleAnalyticsCredentialsJson
            ));
            Nav.NavigateTo("login", replace: true);
        }
        catch (Exception ex)
        {
            errorMsg = $"Setup failed: {ex.Message}";
        }
        finally { isSubmitting = false; }
    }

    private class SetupModel
    {
        public string Username { get; set; } = "";
        public string DisplayName { get; set; } = "Admin";
        public string Password { get; set; } = "";
        public string SiteName { get; set; } = "";
        public string SiteUrl { get; set; } = "";
        public string SiteDescription { get; set; } = "";
        public string? DefaultOgImage { get; set; }
        public string AiProvider { get; set; } = "github-copilot";
        public string AiApiKey { get; set; } = "";
        public string? AiBaseUrl { get; set; }
        public string? AiModel { get; set; }
        public string? AiExportModel { get; set; }
        public string? GoogleAnalyticsMeasurementId { get; set; }
        public string? GoogleAnalyticsPropertyId { get; set; }
        public string? GoogleAnalyticsCredentialsJson { get; set; }
    }
}
