<ModalDialog IsOpen="IsOpen" Title="Media Library" OnClose="Close">
    @* role="tablist"/"tab" is deliberately not used: these two buttons swap the dialog body rather
       than toggling pre-rendered panels, and claiming the tab pattern without aria-selected,
       aria-controls and arrow-key navigation announces a contract the markup does not keep. As plain
       buttons they are honest and already operable. *@
    <div class="modal-tabs">
        <button type="button" class="tab-btn @(activeTab == "browse" ? "active" : "")" @onclick='() => activeTab = "browse"'>Browse</button>
        <button type="button" class="tab-btn @(activeTab == "upload" ? "active" : "")" @onclick='() => activeTab = "upload"'>Upload</button>
    </div>

    @if (activeTab == "browse")
    {
        <div class="media-picker-search">
            @* aria-label rather than a visible caption: the search box sits directly under the dialog
               title, which already says what is being searched. *@
            <input class="form-input" type="search" aria-label="Search media"
                   placeholder="Search media…" value="@searchQuery" @oninput="OnSearchInput" />
        </div>
        @if (isLoading)
        {
            <div class="loading-spinner-wrap"><div class="spinner"></div></div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <p class="error-msg">@loadError</p>
        }
        else if (result is null || result.Items.Count == 0)
        {
            <p class="empty-state">
                @(string.IsNullOrWhiteSpace(searchQuery)
                    ? "No media files yet."
                    : $"No media files match “{searchQuery}”.")
            </p>
        }
        else
        {
            <div class="media-grid">
                @foreach (var file in result.Items)
                {
                    @* A button, not a div: selecting a file is an action, and aria-pressed is what
                       reports the state the .selected border only paints. *@
                    <button type="button" class="media-thumb @(selected?.Id == file.Id ? "selected" : "")"
                            aria-pressed="@((selected?.Id == file.Id).ToString().ToLowerInvariant())"
                            @onclick="() => SelectFile(file)">
                        @if (file.ContentType.StartsWith("image/"))
                        {
                            @* alt="" because the adjacent name already carries the title; a repeat
                               would have the button announce itself twice. *@
                            <img src="@file.PublicPath" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="media-file-icon" aria-hidden="true">📄</span>
                        }
                        <span class="media-thumb-name">@file.Title</span>
                    </button>
                }
            </div>

            <Pager CurrentPage="currentPage"
                   TotalCount="result.TotalCount"
                   PageSize="result.PageSize"
                   OnPageChanged="LoadMedia" />
        }
        @if (selected != null)
        {
            <div class="media-picker-footer">
                <span class="selected-name">@selected.Title</span>
                <button type="button" class="btn btn-primary" @onclick="InsertSelected">Insert</button>
            </div>
        }
    }
    else
    {
        <div class="upload-area">
            @* The input stays inside the label — .upload-label is the dashed drop zone and pulling it
               out would leave the input sitting below the box. The explicit for/id is added on top of
               that implicit association so both upload controls in the admin read the same way. *@
            <label class="upload-label" for="@fileId">
                <span>Choose file to upload</span>
                <InputFile id="@fileId" OnChange="HandleFileUpload" accept="image/*,video/*,application/pdf" />
            </label>
            <div class="form-group">
                <label class="form-label" for="@titleId">Title</label>
                <input id="@titleId" class="form-input" @bind="uploadTitle" placeholder="File title" />
            </div>
            <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@isUploading">
                @if (isUploading) { <span class="spinner-sm"></span> } else { <span>Upload</span> }
            </button>
            @if (!string.IsNullOrEmpty(uploadError))
            {
                <p class="error-msg">@uploadError</p>
            }
        </div>
    }
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<MediaFileDto> OnInsert { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] private ApiClient Api { get; set; } = default!;

    // Per instance, for the same reason ModalDialog generates its title id: an editor can hold more
    // than one component that renders a "Title" field, and duplicate ids make label association
    // resolve to whichever the browser saw first.
    private readonly string fileId = $"picker-file-{Guid.NewGuid():N}";
    private readonly string titleId = $"picker-title-{Guid.NewGuid():N}";

    private string activeTab = "browse";
    private string searchQuery = "";
    private PagedResult<MediaFileDto>? result;
    private MediaFileDto? selected;
    private bool isLoading;
    private bool isUploading;
    private int currentPage = 1;
    private string uploadTitle = "";
    private string uploadError = "";
    private string loadError = "";
    private IBrowserFile? uploadFile;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        // Searched server-side, so a file outside the loaded page is still findable — the whole
        // point of the finding: the picker used to filter its own 20-row window.
        await LoadMedia(1);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && result == null)
            await LoadMedia(1);
    }

    private async Task LoadMedia(int page)
    {
        isLoading = true;
        currentPage = page;
        loadError = "";
        // Selecting on one page and then paging away would leave the footer offering to insert a
        // file the user can no longer see.
        selected = null;
        // Caught rather than left to propagate: this is a modal over an editor that may hold
        // unsaved content, so an unhandled throw here would take the whole circuit down with it.
        try { result = await Api.GetMediaAsync(searchQuery, page); }
        catch (Exception ex) { loadError = ex.Message; }
        finally { isLoading = false; }
    }

    private void SelectFile(MediaFileDto file) => selected = file;

    private async Task InsertSelected()
    {
        if (selected != null)
        {
            await OnInsert.InvokeAsync(selected);
            await Close();
        }
    }

    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadFile = e.File;
        if (string.IsNullOrWhiteSpace(uploadTitle))
            uploadTitle = Path.GetFileNameWithoutExtension(e.File.Name);
    }

    private async Task UploadFile()
    {
        if (uploadFile == null) return;
        isUploading = true;
        uploadError = "";
        try
        {
            await using var stream = uploadFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var uploaded = await Api.UploadMediaAsync(uploadTitle, stream, uploadFile.Name, uploadFile.ContentType);
            if (uploaded != null)
            {
                // Clear the search too, otherwise the fresh upload can land outside the filter the
                // user happened to have typed and the browse tab looks empty.
                searchQuery = "";
                await LoadMedia(1);
                activeTab = "browse";
                selected = uploaded;
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Upload failed: {ex.Message}";
        }
        finally { isUploading = false; }
    }

    private async Task Close()
    {
        selected = null;
        await OnClose.InvokeAsync();
    }
}
