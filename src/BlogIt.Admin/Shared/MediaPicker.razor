@if (IsOpen)
{
    <div class="modal-overlay" @onclick="HandleOverlayClick">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Media Library</h2>
                <button class="modal-close" @onclick="Close">✕</button>
            </div>
            <div class="modal-tabs">
                <button class="tab-btn @(activeTab == "browse" ? "active" : "")" @onclick='() => activeTab = "browse"'>Browse</button>
                <button class="tab-btn @(activeTab == "upload" ? "active" : "")" @onclick='() => activeTab = "upload"'>Upload</button>
            </div>

            @if (activeTab == "browse")
            {
                <div class="media-picker-search">
                    <input class="form-input" placeholder="Search media…" value="@searchQuery" @oninput="OnSearchInput" />
                </div>
                @if (isLoading)
                {
                    <div class="loading-spinner-wrap"><div class="spinner"></div></div>
                }
                else if (!string.IsNullOrEmpty(loadError))
                {
                    <p class="error-msg">@loadError</p>
                }
                else if (result is null || result.Items.Count == 0)
                {
                    <p class="empty-state">
                        @(string.IsNullOrWhiteSpace(searchQuery)
                            ? "No media files yet."
                            : $"No media files match “{searchQuery}”.")
                    </p>
                }
                else
                {
                    <div class="media-grid">
                        @foreach (var file in result.Items)
                        {
                            <div class="media-thumb @(selected?.Id == file.Id ? "selected" : "")" @onclick="() => SelectFile(file)">
                                @if (file.ContentType.StartsWith("image/"))
                                {
                                    <img src="@file.PublicPath" alt="@file.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="media-file-icon">📄</div>
                                }
                                <span class="media-thumb-name">@file.Title</span>
                            </div>
                        }
                    </div>

                    <Pager CurrentPage="currentPage"
                           TotalCount="result.TotalCount"
                           PageSize="result.PageSize"
                           OnPageChanged="LoadMedia" />
                }
                @if (selected != null)
                {
                    <div class="media-picker-footer">
                        <span class="selected-name">@selected.Title</span>
                        <button class="btn btn-primary" @onclick="InsertSelected">Insert</button>
                    </div>
                }
            }
            else
            {
                <div class="upload-area">
                    <label class="upload-label">
                        <span>Choose file to upload</span>
                        <InputFile OnChange="HandleFileUpload" accept="image/*,video/*,application/pdf" />
                    </label>
                    <div class="form-group">
                        <label class="form-label">Title</label>
                        <input class="form-input" @bind="uploadTitle" placeholder="File title" />
                    </div>
                    <button class="btn btn-primary" @onclick="UploadFile" disabled="@isUploading">
                        @if (isUploading) { <span class="spinner-sm"></span> } else { <span>Upload</span> }
                    </button>
                    @if (!string.IsNullOrEmpty(uploadError))
                    {
                        <p class="error-msg">@uploadError</p>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<MediaFileDto> OnInsert { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] private ApiClient Api { get; set; } = default!;

    private string activeTab = "browse";
    private string searchQuery = "";
    private PagedResult<MediaFileDto>? result;
    private MediaFileDto? selected;
    private bool isLoading;
    private bool isUploading;
    private int currentPage = 1;
    private string uploadTitle = "";
    private string uploadError = "";
    private string loadError = "";
    private IBrowserFile? uploadFile;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        // Searched server-side, so a file outside the loaded page is still findable — the whole
        // point of the finding: the picker used to filter its own 20-row window.
        await LoadMedia(1);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && result == null)
            await LoadMedia(1);
    }

    private async Task LoadMedia(int page)
    {
        isLoading = true;
        currentPage = page;
        loadError = "";
        // Selecting on one page and then paging away would leave the footer offering to insert a
        // file the user can no longer see.
        selected = null;
        // Caught rather than left to propagate: this is a modal over an editor that may hold
        // unsaved content, so an unhandled throw here would take the whole circuit down with it.
        try { result = await Api.GetMediaAsync(searchQuery, page); }
        catch (Exception ex) { loadError = ex.Message; }
        finally { isLoading = false; }
    }

    private void SelectFile(MediaFileDto file) => selected = file;

    private async Task InsertSelected()
    {
        if (selected != null)
        {
            await OnInsert.InvokeAsync(selected);
            await Close();
        }
    }

    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        uploadFile = e.File;
        if (string.IsNullOrWhiteSpace(uploadTitle))
            uploadTitle = Path.GetFileNameWithoutExtension(e.File.Name);
    }

    private async Task UploadFile()
    {
        if (uploadFile == null) return;
        isUploading = true;
        uploadError = "";
        try
        {
            await using var stream = uploadFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var uploaded = await Api.UploadMediaAsync(uploadTitle, stream, uploadFile.Name, uploadFile.ContentType);
            if (uploaded != null)
            {
                // Clear the search too, otherwise the fresh upload can land outside the filter the
                // user happened to have typed and the browse tab looks empty.
                searchQuery = "";
                await LoadMedia(1);
                activeTab = "browse";
                selected = uploaded;
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Upload failed: {ex.Message}";
        }
        finally { isUploading = false; }
    }

    private async Task Close()
    {
        selected = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleOverlayClick() => await Close();
}
