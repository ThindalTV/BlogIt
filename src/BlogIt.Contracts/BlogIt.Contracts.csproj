<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlogIt.Contracts</AssemblyName>
    <PackageId>BlogIt.Contracts</PackageId>
    <IsPackable>false</IsPackable>
    <Description>Browser-safe contracts shared by BlogIt clients and the server.</Description>
  </PropertyGroup>

  <!--
    Not packable on its own, but BlogIt.dll's package carries BlogIt.Contracts.dll beside it (see
    IncludeBlogItContractsInPackage in src/BlogIt/BlogIt.csproj), so it reaches customers and has to
    carry the release stamp for the same reason: a stack trace crossing this assembly must identify
    the build. Imported last so a Version or VersionPrefix set above is visible to it.
  -->
  <Import Project="..\..\build\BlogIt.Versioning.props" />

</Project>
