@inherits LayoutComponentBase
@using BlogIt.MauiAdmin.Models
@using BlogIt.MauiAdmin.Services
@inject SiteProfileService ProfileService
@inject NavigationManager Nav
@implements IDisposable

<div class="top-bar">
    <span class="top-bar__logo">BlogIt Admin</span>

    <div class="top-bar__site-switcher">
        @if (_profiles.Count > 0)
        {
            <select @onchange="OnSiteChanged" title="Active site">
                @foreach (var p in _profiles)
                {
                    <option value="@p.Id" selected="@(p.Id == _activeId)">@p.Name</option>
                }
            </select>
        }
        <button class="btn-icon" @onclick='() => Nav.NavigateTo("/sites")' title="Manage sites">⚙</button>
    </div>

    <div class="top-bar__user">
        @if (_activeProfile is not null)
        {
            <span class="top-bar__username">@(_activeProfile.DisplayName ?? _activeProfile.Username ?? "Admin")</span>
        }
        <button class="btn btn-sm btn-outline" @onclick="Logout">Log out</button>
    </div>
</div>

<div class="app-shell">
    <nav class="sidebar">
        <NavLink href="/dashboard" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">⊞</span> Dashboard
        </NavLink>
        <NavLink href="/posts" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">✍</span> Posts
        </NavLink>
        <NavLink href="/pages" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">📄</span> Pages
        </NavLink>
        <NavLink href="/media" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">🖼</span> Media
        </NavLink>
        <NavLink href="/ai" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">🤖</span> AI Brainstorm
        </NavLink>
        <NavLink href="/users" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">👥</span> Users
        </NavLink>
        <NavLink href="/settings" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">⚙</span> Settings
        </NavLink>
        <NavLink href="/account" class="sidebar__link" ActiveClass="sidebar__link--active">
            <span class="sidebar__icon">🔑</span> My Account
        </NavLink>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private List<SiteProfile> _profiles = [];
    private SiteProfile? _activeProfile;
    private string? _activeId;

    protected override async Task OnInitializedAsync()
    {
        ProfileService.OnChanged += OnProfilesChanged;
        await LoadProfilesAsync();
    }

    private async Task LoadProfilesAsync()
    {
        _profiles = await ProfileService.GetProfilesAsync();
        _activeProfile = await ProfileService.GetActiveProfileAsync();
        _activeId = _activeProfile?.Id;
        StateHasChanged();
    }

    private async Task OnSiteChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (id is null) return;
        await ProfileService.SetActiveAsync(id);
        await LoadProfilesAsync();
        Nav.NavigateTo("/dashboard");
    }

    private async Task Logout()
    {
        if (_activeProfile is not null)
            await ProfileService.ClearTokenAsync(_activeProfile.Id);
        Nav.NavigateTo("/login");
    }

    private void OnProfilesChanged() => InvokeAsync(LoadProfilesAsync);

    public void Dispose() => ProfileService.OnChanged -= OnProfilesChanged;
}

