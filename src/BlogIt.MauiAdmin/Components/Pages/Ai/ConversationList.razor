@page "/ai"
@inject MauiApiClient Api
@inject NavigationManager Nav
@inject SiteProfileService ProfileService

<div class="page-header">
    <h1 class="page-title">AI Brainstorm</h1>
    <button class="btn btn-primary" @onclick="ShowNewForm">+ New Conversation</button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_showNewForm)
{
    <div class="card" style="margin-bottom:1rem">
        <div class="form-group">
            <label>Conversation Title</label>
            <input class="form-control" @bind="_newTitle" placeholder="e.g. Blog post ideas for Q3"
                   @onkeydown="OnNewTitleKey" autofocus />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_creating">
                @(_creating ? "Creating…" : "Create")
            </button>
            <button class="btn btn-outline" @onclick="HideNewForm">Cancel</button>
        </div>
    </div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else if (_conversations is not null)
{
    @if (_conversations.Count == 0)
    {
        <p class="text-muted">No conversations yet. Start one to brainstorm ideas with AI.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Messages</th>
                    <th>Last Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var conv in _conversations)
                {
                    <tr>
                        <td>@conv.Title</td>
                        <td>@conv.MessageCount</td>
                        <td>@conv.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="table-actions">
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => OpenConversation(conv.Id)">Open</button>
                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => ConfirmDelete(conv.Id, conv.Title)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (_confirmDeleteId.HasValue)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog card">
            <p>Delete "<strong>@_confirmDeleteTitle</strong>"? This cannot be undone.</p>
            <div class="confirm-actions">
                <button class="btn btn-danger" @onclick="DoDeleteAsync">Yes, Delete</button>
                <button class="btn btn-outline" @onclick="() => { _confirmDeleteId = null; }">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AiConversationSummaryDto>? _conversations;
    private bool _loading = true;
    private string? _error;
    private bool _showNewForm;
    private bool _creating;
    private string _newTitle = "";
    private Guid? _confirmDeleteId;
    private string? _confirmDeleteTitle;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        if (profile?.IsTokenValid != true) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _conversations = await Api.GetConversationsAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private void ShowNewForm() { _showNewForm = true; _newTitle = ""; }
    private void HideNewForm() { _showNewForm = false; _newTitle = ""; }
    private void OpenConversation(Guid id) => Nav.NavigateTo($"/ai/{id}");

    private async Task OnNewTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateAsync();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        _creating = true;
        var conv = await Api.CreateConversationAsync(_newTitle.Trim());
        _creating = false;
        if (conv is not null)
            Nav.NavigateTo($"/ai/{conv.Id}");
        else
            _error = "Failed to create conversation.";
    }

    private void ConfirmDelete(Guid id, string? title)
    {
        _confirmDeleteId = id;
        _confirmDeleteTitle = title;
    }

    private async Task DoDeleteAsync()
    {
        if (_confirmDeleteId is null) return;
        await Api.DeleteConversationAsync(_confirmDeleteId.Value);
        _confirmDeleteId = null;
        await LoadAsync();
    }
}
