@page "/dashboard"
@inject MauiApiClient Api
@inject NavigationManager Nav
@inject SiteProfileService ProfileService

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <div class="page-header__actions">
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("/posts/new")'>+ New Post</button>
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("/pages/new")'>+ New Page</button>
    </div>
</div>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="dashboard-grid">
        <div class="card">
            <h2 class="card-title">Analytics — Last 30 Days</h2>
            @if (_analyticsError)
            {
                <p class="text-muted">Analytics not configured. Set up Google Analytics in Settings.</p>
            }
            else if (_analytics is null)
            {
                <p class="text-muted">No analytics data available.</p>
            }
            else
            {
                <div class="stats-row">
                    <div class="stat-box">
                        <span class="stat-value">@_analytics.PageViews</span>
                        <span class="stat-label">Page Views</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-value">@_analytics.Sessions</span>
                        <span class="stat-label">Sessions</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-value">@_analytics.Users</span>
                        <span class="stat-label">Users</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-value">—</span>
                        <span class="stat-label">Avg. Session</span>
                    </div>
                </div>

                @if (_analytics.TopPages?.Count > 0)
                {
                    <h3 class="section-subtitle">Top Pages</h3>
                    <table class="table">
                        <thead>
                            <tr><th>Page</th><th>Views</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _analytics.TopPages)
                            {
                                <tr>
                                    <td>@p.Path</td>
                                    <td>@p.Views</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>

        <div class="card">
            <h2 class="card-title">Recent Posts</h2>
            @if (_posts is null || _posts.Count == 0)
            {
                <p class="text-muted">No posts yet. <a href="/posts/new">Create one →</a></p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>Title</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var post in _posts)
                        {
                            <tr>
                                <td>@post.Title</td>
                                <td>
                                    @if (post.IsPublished)
                                    {
                                        <span class="badge badge-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Draft</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline"
                                           @onclick="() => EditPost(post.Id)">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private AnalyticsSummaryDto? _analytics;
    private List<BlogPostSummaryDto>? _posts;
    private bool _loading = true;
    private bool _analyticsError;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        if (profile?.IsTokenValid != true) { Nav.NavigateTo("/login"); return; }

        var today = DateTime.Today;
        var start = today.AddDays(-30).ToString("yyyy-MM-dd");
        var end = today.ToString("yyyy-MM-dd");

        var analyticsTask = Api.GetAnalyticsSummaryAsync(start, end);
        var postsTask = Api.GetPostsAsync(page: 1, status: "all");

        try { _analytics = await analyticsTask; }
        catch { _analyticsError = true; }

        try
        {
            var pagedPosts = await postsTask;
            _posts = pagedPosts?.Items?.Take(10).ToList();
        }
        catch { /* ignore */ }

        _loading = false;
    }

    private void EditPost(Guid id) => Nav.NavigateTo($"/posts/{id}");
}
