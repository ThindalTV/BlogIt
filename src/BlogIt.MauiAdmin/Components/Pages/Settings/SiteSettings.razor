@page "/settings"
@inject MauiApiClient Api
@inject NavigationManager Nav
@inject SiteProfileService ProfileService

<div class="page-header">
    <h1 class="page-title">Site Settings</h1>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success">@_success</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <div class="card">
        <h2 class="card-title">General</h2>
        <div class="form-group">
            <label>Site Name</label>
            <input class="form-control" @bind='_settings["SiteName"]' />
        </div>
        <div class="form-group">
            <label>Site URL</label>
            <input class="form-control" @bind='_settings["SiteUrl"]' placeholder="https://example.com" />
        </div>
        <div class="form-group">
            <label>Site Description</label>
            <textarea class="form-control" rows="3" @bind='_settings["SiteDescription"]'></textarea>
        </div>
        <div class="form-group">
            <label>Default OG Image URL</label>
            <input class="form-control" @bind='_settings["DefaultOgImage"]' placeholder="https://…" />
        </div>
    </div>

    <div class="card" style="margin-top:1rem">
        <h2 class="card-title">AI</h2>
        <div class="form-group">
            <label>Provider</label>
            <input class="form-control" @bind='_settings["AiProvider"]' placeholder="e.g. OpenAI" />
        </div>
        <div class="form-group">
            <label>API Key</label>
            <input class="form-control" type="password" @bind='_settings["AiApiKey"]' />
        </div>
        <div class="form-group">
            <label>Base URL</label>
            <input class="form-control" @bind='_settings["AiBaseUrl"]' placeholder="https://api.openai.com/v1" />
        </div>
        <div class="form-group">
            <label>Model</label>
            <input class="form-control" @bind='_settings["AiModel"]' placeholder="gpt-4o" />
        </div>
        <div class="form-group">
            <label>Export Model</label>
            <input class="form-control" @bind='_settings["AiExportModel"]' placeholder="gpt-4o" />
        </div>
    </div>

    <div class="card" style="margin-top:1rem">
        <h2 class="card-title">Google Analytics</h2>
        <div class="form-group">
            <label>Measurement ID</label>
            <input class="form-control" @bind='_settings["GoogleAnalyticsMeasurementId"]' placeholder="G-XXXXXXXXXX" />
        </div>
        <div class="form-group">
            <label>Property ID</label>
            <input class="form-control" @bind='_settings["GoogleAnalyticsPropertyId"]' placeholder="properties/123456789" />
        </div>
        <div class="form-group">
            <label>Service Account Credentials JSON</label>
            <textarea class="form-control" rows="6" @bind='_settings["GoogleAnalyticsCredentialsJson"]'
                      placeholder='{ "type": "service_account", … }'
                      style="-webkit-text-security: disc; font-family: monospace"></textarea>
        </div>
    </div>

    <div class="form-actions" style="margin-top:1rem">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @(_saving ? "Saving…" : "Save Settings")
        </button>
    </div>
}

@code {
    private Dictionary<string, string> _settings = new();
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _success;

    private static readonly string[] SettingKeys =
    [
        "SiteName", "SiteUrl", "SiteDescription", "DefaultOgImage",
        "AiProvider", "AiApiKey", "AiBaseUrl", "AiModel", "AiExportModel",
        "GoogleAnalyticsMeasurementId", "GoogleAnalyticsPropertyId", "GoogleAnalyticsCredentialsJson"
    ];

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetActiveProfileAsync();
        if (profile?.IsTokenValid != true) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var loaded = await Api.GetSettingsAsync() ?? new Dictionary<string, string>();
            // Ensure all expected keys exist so bindings don't throw
            foreach (var key in SettingKeys)
                _settings[key] = loaded.TryGetValue(key, out var v) ? v : "";
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _success = null;

        // Only send non-empty values (skip blanks for sensitive fields to avoid overwriting with empty)
        var payload = _settings
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

        var ok = await Api.UpdateSettingsAsync(payload);
        if (ok) _success = "Settings saved.";
        else _error = "Failed to save settings.";

        _saving = false;
    }
}
