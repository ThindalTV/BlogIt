@page "/sites"
@using BlogIt.MauiAdmin.Models
@using BlogIt.MauiAdmin.Services
@inject SiteProfileService ProfileService
@inject NavigationManager Nav

<h1>Manage Sites</h1>
<p>Add connections to different BlogIt installations. Switch between them from the top bar.</p>

@if (_profiles.Count == 0)
{
    <div class="alert alert-info">No sites configured yet. Add your first site below.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>API URL</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _profiles)
            {
                <tr class="@(p.Id == _activeId ? "row-active" : "")">
                    <td>
                        @p.Name
                        @if (p.Id == _activeId)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                    </td>
                    <td>@p.ApiBaseUrl</td>
                    <td>
                        @if (p.IsTokenValid)
                        {
                            <span class="badge badge-success">Logged in as @p.Username</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">Not logged in</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => SetActive(p.Id)">
                            Use
                        </button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => StartEdit(p)">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(p.Id)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />
<h2>@(_editingProfile is null ? "Add Site" : "Edit Site")</h2>

<div class="form-section">
    <div class="form-group">
        <label>Site Name</label>
        <input class="form-control" @bind="_formName" placeholder="e.g. ericjohansson.se" />
    </div>
    <div class="form-group">
        <label>API Base URL</label>
        <input class="form-control" @bind="_formUrl" placeholder="https://yoursite.com" />
        <small class="form-hint">Base URL of your BlogIt installation (no trailing slash needed)</small>
    </div>

    @if (!string.IsNullOrEmpty(_formError))
    {
        <div class="alert alert-danger">@_formError</div>
    }

    <div class="form-actions">
        <button class="btn btn-primary" @onclick="SaveProfile" disabled="@_saving">
            @(_saving ? "Saving…" : (_editingProfile is null ? "Add Site" : "Save Changes"))
        </button>
        @if (_editingProfile is not null)
        {
            <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
        }
    </div>
</div>

@if (_profiles.Count > 0)
{
    <div class="form-actions" style="margin-top:2rem">
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/dashboard")'>
            Go to Dashboard →
        </button>
    </div>
}

@code {
    private List<SiteProfile> _profiles = [];
    private string? _activeId;
    private string _formName = "";
    private string _formUrl = "";
    private string? _formError;
    private bool _saving;
    private SiteProfile? _editingProfile;

    protected override async Task OnInitializedAsync()
    {
        _profiles = await ProfileService.GetProfilesAsync();
        var active = await ProfileService.GetActiveProfileAsync();
        _activeId = active?.Id;
    }

    private async Task SetActive(string id)
    {
        await ProfileService.SetActiveAsync(id);
        _activeId = id;
    }

    private void StartEdit(SiteProfile p)
    {
        _editingProfile = p;
        _formName = p.Name;
        _formUrl = p.ApiBaseUrl;
        _formError = null;
    }

    private void CancelEdit()
    {
        _editingProfile = null;
        _formName = "";
        _formUrl = "";
        _formError = null;
    }

    private async Task SaveProfile()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Site name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_formUrl) || !Uri.TryCreate(_formUrl, UriKind.Absolute, out _))
        {
            _formError = "A valid URL is required (e.g. https://yoursite.com).";
            return;
        }

        _saving = true;
        var profile = _editingProfile ?? new SiteProfile();
        profile.Name = _formName.Trim();
        profile.ApiBaseUrl = _formUrl.TrimEnd('/');

        await ProfileService.AddOrUpdateProfileAsync(profile);
        _profiles = await ProfileService.GetProfilesAsync();
        var active = await ProfileService.GetActiveProfileAsync();
        _activeId = active?.Id;

        _editingProfile = null;
        _formName = "";
        _formUrl = "";
        _saving = false;
    }

    private async Task ConfirmDelete(string id)
    {
        // Simple confirm — on mobile a native dialog could be used; keeping it simple here
        await ProfileService.DeleteProfileAsync(id);
        _profiles = await ProfileService.GetProfilesAsync();
        var active = await ProfileService.GetActiveProfileAsync();
        _activeId = active?.Id;
    }
}
