<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BlogIt.MauiAdmin.ViewModels.Settings"
             x:Class="BlogIt.MauiAdmin.Views.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            <Label Text="{Binding StatusMessage}" TextColor="Green" IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            <Label Text="Site" FontSize="16" FontAttributes="Bold" />
            <Label Text="Site Name" FontSize="12" />
            <Entry Text="{Binding SiteName}" />
            <Label Text="Site URL" FontSize="12" />
            <Entry Text="{Binding SiteUrl}" Keyboard="Url" />
            <Label Text="Description" FontSize="12" />
            <Editor Text="{Binding SiteDescription}" HeightRequest="60" AutoSize="TextChanges" />
            <Label Text="Default OG Image" FontSize="12" />
            <Entry Text="{Binding DefaultOgImage}" Keyboard="Url" />

            <Label Text="AI" FontSize="16" FontAttributes="Bold" Margin="0,16,0,0" />
            <Label Text="Provider (openai-compatible / github-copilot)" FontSize="12" />
            <Entry Text="{Binding AiProvider}" />
            <Label Text="Base URL" FontSize="12" />
            <Entry Text="{Binding AiBaseUrl}" Keyboard="Url" />
            <Label Text="API Key (leave blank to keep current)" FontSize="12" />
            <Entry Text="{Binding AiApiKey}" IsPassword="True" />
            <Label Text="Model" FontSize="12" />
            <Entry Text="{Binding AiModel}" />
            <Label Text="Draft-Export Model" FontSize="12" />
            <Entry Text="{Binding AiExportModel}" />

            <Label Text="Analytics" FontSize="16" FontAttributes="Bold" Margin="0,16,0,0" />
            <Label Text="Measurement ID" FontSize="12" />
            <Entry Text="{Binding GaMeasurementId}" />
            <Label Text="Property ID" FontSize="12" />
            <Entry Text="{Binding GaPropertyId}" />
            <Label Text="Service Account Credentials JSON (leave blank to keep current)" FontSize="12" />
            <Editor Text="{Binding GaCredentialsJson}" HeightRequest="80" AutoSize="TextChanges" />

            <Label Text="Auth" FontSize="16" FontAttributes="Bold" Margin="0,16,0,0" />
            <Label Text="JWT Expiry (minutes, 5–10080)" FontSize="12" />
            <Entry Text="{Binding JwtExpiryMinutesText}" Keyboard="Numeric" />

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
