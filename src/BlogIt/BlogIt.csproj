<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlogIt</AssemblyName>
    <PackageId>BlogIt</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>ThindalTV</Authors>
    <Description>Embeddable ASP.NET Core blog engine with SQL Server persistence, a packaged administration UI and APIs, filesystem media storage, and host-defined public views.</Description>
    <PackageTags>aspnetcore;blog;cms;blazor;razor;sql-server</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Matches LICENSE.txt in the repository root. Without it NuGet.org renders "License not
      specified", which is indistinguishable from proprietary to anyone evaluating the package.
      An SPDX expression rather than a packed <PackageLicenseFile> so the metadata is
      machine-readable for consumers running license audits, and so the licence does not have to be
      duplicated into each satellite package's own content.
    -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <AdminProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\BlogIt.Admin\BlogIt.Admin.csproj'))</AdminProject>
    <AdminBuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)admin-build\'))</AdminBuildRoot>
    <AdminPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)admin-publish\$(Configuration)\'))\</AdminPublishDir>
    <AdminAssetsDir>$(AdminPublishDir)wwwroot\blogit\</AdminAssetsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlogIt.Admin\BlogIt.Admin.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <!--
      No PrivateAssets here, deliberately: this has to become a real nuspec dependency on
      BlogIt.Contracts rather than a private reference whose DLL gets injected into this package's own
      lib folder. It was the latter, which left the contracts assembly with no independent version and
      no way for a client to take it alone. Packing it separately also means the reference flows
      transitively, so the satellites no longer need a contracts reference of their own.
      The exact version pairing (nuspec dependency equal to this package's version) is what NuGet
      writes for a ProjectReference and what verify.ps1 asserts literally - the DTOs are the wire
      format both halves serialise against, so a mismatched pair is a silent serialisation bug.
    -->
    <ProjectReference Include="..\BlogIt.Contracts\BlogIt.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Every version here is an exact pin, never a floating range. A packed nuspec turns these
    into the consuming application's dependency floor, and a floating range is re-resolved
    on the consumer's machine at restore time: two people installing the same BlogIt version
    a week apart would compile against different dependency builds, which contradicts the
    <Deterministic>true</Deterministic> above. The 10.0.* references were previously
    "10.0.0-preview.*"; that wildcard also matched the 10.0.0 release once .NET 10 shipped,
    so it happened to resolve to a stable build - but only by accident, and it still offered
    every consumer a preview floor. Pinned to 10.0.11, the current .NET 10 servicing patch,
    so the JwtBearer and EF Core floor includes shipped security fixes rather than 10.0.0.
    Bump these in lockstep with the servicing band, and update the expected versions in
    build/package-layout-tests/verify.ps1 in the same commit.

    Two SDKs are deliberately absent and must stay absent. OpenAI lives in BlogIt.OpenAi and
    Google.Analytics.Data.V1Beta in BlogIt.GoogleAnalytics, reached through
    IBlogItAiProviderRegistration and IBlogItAnalyticsProviderRegistration - the same satellite
    shape BlogIt.AzureStorage already uses for media. They were unconditional here, so every
    consumer restored the OpenAI client and the whole Gax/gRPC/Protobuf tree whether or not it used
    either feature, and - because the Google client has no stable release - a stable BlogIt 1.0.0
    would have raised NU5104 and been rejected outright by feeds that block prerelease transitives.
    verify.ps1 asserts both their absence from this nuspec and their absence from a BlogIt-only
    consumer's restore graph.
  -->
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="$(NuGetPackageRoot)microsoft.codeanalysis.workspaces.msbuild\*\contentFiles\any\any\BuildHost-*\**"
             Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
    <None Include="buildTransitive\BlogIt.targets"
          Pack="true"
          PackagePath="buildTransitive\BlogIt.targets" />
  </ItemGroup>

  <!--
    CompressionEnabled=false suppresses the Blazor publish pipeline's .br/.gz variants.
    They were 428 of the 642 published files and 18.4 MB of the 45.7 MB tree, and none of
    them could ever be served: AdminAssetMiddlewareContributor hands this tree to a plain
    UseStaticFiles over a private PhysicalFileProvider, which does no Accept-Encoding
    negotiation, and the admin assets are not registered as ASP.NET Core static web assets
    (the pipeline that would have negotiated them). So every consuming project was carrying
    them into bin/ and publish/ for nothing.
    The alternative - keeping them and writing real negotiation - was rejected: it would
    keep the whole 45.7 MB on every consumer's disk in order to save transfer that a host
    already gets from UseResponseCompression or the proxy/CDN in front of it, and it would
    add a hand-rolled middleware that has to get q-values, identity;q=0, Content-Encoding,
    Vary, the inner extension's content type and per-variant validators right forever.
    Suppressing generation rather than filtering at pack time keeps the packaged tree
    byte-identical to the publish tree (which build/package-layout-tests/verify.ps1 asserts
    as a set) and drops the brotli pass from every Release build.
    Note this is a publish-pipeline property, not a BlogIt one: if a future SDK renames it,
    verify.ps1's precompressed-asset assertion is what will catch the regression.
  -->
  <Target Name="BuildBlogItAdminAssets"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(AdminPublishDir)" />
    <MSBuild Projects="$(AdminProject)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PublishTrimmed=false;CompressionEnabled=false;PublishDir=$(AdminPublishDir);BlogItAdminBuildRoot=$(AdminBuildRoot);BlogItBundledAdminBuild=true" />
    <Error Condition="!Exists('$(AdminAssetsDir)index.html')"
           Text="BlogIt.Admin did not produce $(AdminAssetsDir)index.html." />
    <ItemGroup>
      <_BlogItAdminSourceAsset Include="$(AdminAssetsDir)**\*" />
      <ContentWithTargetPath Include="@(_BlogItAdminSourceAsset)">
        <TargetPath>BlogItAdminAssets\%(_BlogItAdminSourceAsset.RecursiveDir)%(_BlogItAdminSourceAsset.Filename)%(_BlogItAdminSourceAsset.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target Name="IncludeBlogItAdminPackageFiles"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="BuildBlogItAdminAssets">
    <ItemGroup>
      <_BlogItAdminPackageAsset Include="$(AdminAssetsDir)**\*" />
      <None Include="@(_BlogItAdminPackageAsset)"
            Pack="true"
            PackagePath="staticwebassets\BlogItAdminAssets\%(_BlogItAdminPackageAsset.RecursiveDir)%(_BlogItAdminPackageAsset.Filename)%(_BlogItAdminPackageAsset.Extension)" />
    </ItemGroup>
  </Target>

  <!--
    Imported last so a Version or VersionPrefix set above is visible to it. See the file itself for
    why PackageVersion has to be plumbed into the assembly stamps by hand.
  -->
  <Import Project="..\..\build\BlogIt.Versioning.props" />

</Project>
