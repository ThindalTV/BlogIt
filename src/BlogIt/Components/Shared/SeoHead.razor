@using BlogIt.Services
@namespace BlogIt.Components.Shared
@inject ISettingsService SettingsService

<PageTitle>@(string.IsNullOrEmpty(Title) ? siteName : $"{Title} — {siteName}")</PageTitle>

<HeadContent>
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="description" content="@Description" />
    }
    @if (!string.IsNullOrEmpty(Keywords))
    {
        <meta name="keywords" content="@Keywords" />
    }

    @* Open Graph *@
    <meta property="og:type" content="@OgType" />
    <meta property="og:title" content="@(Title ?? siteName)" />
    <meta property="og:site_name" content="@siteName" />
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta property="og:description" content="@Description" />
    }
    @if (!string.IsNullOrEmpty(OgImage ?? defaultOgImage))
    {
        <meta property="og:image" content="@(OgImage ?? defaultOgImage)" />
    }
    @if (!string.IsNullOrEmpty(CanonicalUrl))
    {
        <meta property="og:url" content="@CanonicalUrl" />
        <link rel="canonical" href="@CanonicalUrl" />
    }

    @* Twitter Card *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(Title ?? siteName)" />
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="twitter:description" content="@Description" />
    }
    @if (!string.IsNullOrEmpty(OgImage ?? defaultOgImage))
    {
        <meta name="twitter:image" content="@(OgImage ?? defaultOgImage)" />
    }

    @if (SchemaType != SeoSchemaType.None)
    {
        <script type="application/ld+json">@((MarkupString)BuildStructuredData())</script>
    }
</HeadContent>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Keywords { get; set; }
    [Parameter] public string? OgImage { get; set; }
    [Parameter] public string? CanonicalUrl { get; set; }
    [Parameter] public string OgType { get; set; } = "website";
    [Parameter] public SeoSchemaType SchemaType { get; set; }
    [Parameter] public string? StructuredDataName { get; set; }
    [Parameter] public string? AuthorName { get; set; }
    [Parameter] public DateTime? PublishedAt { get; set; }
    [Parameter] public DateTime? ModifiedAt { get; set; }

    private string siteName = "BlogIt";
    private string? defaultOgImage;

    protected override async Task OnInitializedAsync()
    {
        siteName = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.SiteName) ?? "BlogIt";
        defaultOgImage = await SettingsService.GetAsync(BlogIt.Shared.SettingKeys.DefaultOgImage);
    }

    private string BuildStructuredData()
    {
        var schemaName = StructuredDataName ?? Title ?? siteName;
        var schemaType = SchemaType switch
        {
            SeoSchemaType.WebSite => "WebSite",
            SeoSchemaType.Blog => "Blog",
            SeoSchemaType.BlogPosting => "BlogPosting",
            SeoSchemaType.WebPage => "WebPage",
            SeoSchemaType.CollectionPage => "CollectionPage",
            SeoSchemaType.SearchResultsPage => "SearchResultsPage",
            _ => throw new InvalidOperationException($"Unsupported SEO schema type: {SchemaType}.")
        };

        var data = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = schemaType
        };

        if (SchemaType == SeoSchemaType.BlogPosting)
            data["headline"] = schemaName;
        else
            data["name"] = schemaName;

        if (!string.IsNullOrWhiteSpace(Description))
            data["description"] = Description;
        if (!string.IsNullOrWhiteSpace(CanonicalUrl))
            data["url"] = CanonicalUrl;
        if (PublishedAt.HasValue)
            data["datePublished"] = PublishedAt.Value.ToString("yyyy-MM-dd");
        if (ModifiedAt.HasValue)
            data["dateModified"] = ModifiedAt.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(AuthorName))
        {
            data["author"] = new Dictionary<string, string>
            {
                ["@type"] = "Person",
                ["name"] = AuthorName
            };
        }

        return System.Text.Json.JsonSerializer.Serialize(data);
    }
}
