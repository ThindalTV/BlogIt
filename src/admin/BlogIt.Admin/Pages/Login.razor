@page "/login"
@layout BlogIt.Admin.Layout.LoginLayout
@inject ApiClient Api
@inject AuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <span class="login-logo">✦</span>
            <h1 class="login-title">BlogIt</h1>
            <p class="login-subtitle">Admin Panel</p>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label class="form-label" for="login-username">Username</label>
                <input id="login-username" class="form-input" type="text" @bind="model.Username" placeholder="Enter username" autocomplete="username" />
            </div>
            <div class="form-group">
                <label class="form-label" for="login-password">Password</label>
                <input id="login-password" class="form-input" type="password" @bind="model.Password" placeholder="Enter password" autocomplete="current-password" />
            </div>
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="alert alert-error">@errorMsg</div>
            }
            <button class="btn btn-primary btn-full" type="submit" disabled="@isLoading">
                @if (isLoading) { <span class="spinner-sm"></span> } else { <span>Sign In</span> }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel model = new();
    private bool isLoading;
    private string errorMsg = "";

    /// <summary>
    /// Page the user was on when a rejected token bounced them here, set by
    /// <see cref="AdminAuthMessageHandler"/>. Sanitised through
    /// <see cref="AdminLoginRedirect.ResolveReturnPath"/> before it is navigated to — it arrives via
    /// the address bar and so is attacker-controlled.
    /// </summary>
    [SupplyParameterFromQuery(Name = AdminLoginRedirect.ReturnUrlKey)]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var setupStatus = await Api.GetSetupStatusAsync();
        if (setupStatus?.IsComplete != true)
        {
            Nav.NavigateTo("setup", replace: true);
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo(AdminLoginRedirect.ResolveReturnPath(ReturnUrl), replace: true);
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMsg = "";
        try
        {
            var resp = await Api.LoginAsync(new LoginRequest(model.Username, model.Password));
            if (resp == null)
            {
                errorMsg = "Invalid username or password.";
            }
            else
            {
                await AuthProvider.MarkUserAsLoggedIn(resp.Token);
                Nav.NavigateTo(AdminLoginRedirect.ResolveReturnPath(ReturnUrl), replace: true);
            }
        }
        catch (Exception ex)
        {
            // ApiClient returns null only for a real 401, so anything reaching here is the server
            // failing rather than the operator mistyping — say which. Its message is already
            // filtered to the API's own error shapes, so no exception page can land on this screen.
            errorMsg = ex.Message;
        }
        finally { isLoading = false; }
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
