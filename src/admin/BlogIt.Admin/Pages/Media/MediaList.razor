@page "/media"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Media — BlogIt Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Media</h1>
    @* The input used to be hidden with display:none inside this label, which took it out of the tab
       order entirely — and since a <label> is not focusable either, there was no way to start an
       upload from the keyboard at all. .visually-hidden clips it instead of removing it, so it keeps
       its tab stop, takes the label as its name, and .upload-trigger:focus-within draws the ring on
       the button-shaped label the user actually sees. *@
    <label class="btn btn-primary upload-trigger" for="media-upload">+ Upload</label>
    <InputFile id="media-upload" class="visually-hidden" OnChange="HandleUpload"
               accept="image/*,video/*,application/pdf" />
</div>

<div class="toolbar">
    <input class="form-input toolbar-search" type="search" aria-label="Search media"
           placeholder="Search media…" value="@searchQuery" @oninput="OnSearchInput" />
</div>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-error">@errorMsg</div>
}
@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success">@successMsg</div>
}

@if (isLoading)
{
    <div class="loading-spinner-wrap"><div class="spinner"></div></div>
}
else if (result == null || result.Items.Count == 0)
{
    <p class="empty-state">
        @(string.IsNullOrWhiteSpace(searchQuery)
            ? "No media files yet."
            : $"No media files match “{searchQuery}”.")
    </p>
}
else
{
    <p class="list-summary">@RangeSummary()</p>

    <div class="media-grid media-grid-page">
        @foreach (var file in result.Items)
        {
            @* A button rather than a div with @onclick: selecting a file reveals the detail bar with
               Copy URL and Delete, so it is the entry point to both and cannot be mouse-only.
               aria-pressed carries the state that the .selected outline shows visually. *@
            <button type="button" class="media-card @(selectedFile?.Id == file.Id ? "selected" : "")"
                    aria-pressed="@((selectedFile?.Id == file.Id).ToString().ToLowerInvariant())"
                    @onclick="() => SelectFile(file)">
                @if (file.ContentType.StartsWith("image/"))
                {
                    <div class="media-card-thumb">
                        @* alt="" so the name below is the button's only announced text. *@
                        <img src="@file.PublicPath" alt="" loading="lazy" />
                    </div>
                }
                else
                {
                    <div class="media-card-thumb media-card-icon">
                        <span aria-hidden="true">📄</span>
                    </div>
                }
                <div class="media-card-info">
                    <span class="media-card-name" title="@file.Title">@file.Title</span>
                    <span class="media-card-size">@FormatSize(file.SizeBytes) · @file.ViewCount.ToString("N0") @(file.ViewCount == 1 ? "view" : "views")</span>
                </div>
            </button>
        }
    </div>

    <Pager CurrentPage="currentPage"
           TotalCount="result.TotalCount"
           PageSize="result.PageSize"
           OnPageChanged="LoadMedia" />
}

@if (selectedFile != null)
{
    <div class="media-detail-bar">
        <div class="media-detail-info">
            <strong>@selectedFile.Title</strong>
            <span>@selectedFile.FileName</span>
            <span>@FormatSize(selectedFile.SizeBytes)</span>
            <span>@selectedFile.UploadedAt.ToString("MMM d, yyyy")</span>
            <span>@selectedFile.ViewCount.ToString("N0") @(selectedFile.ViewCount == 1 ? "view" : "views")</span>
        </div>
        <div class="media-detail-actions">
            <button class="btn btn-secondary" @onclick="CopyUrl">Copy URL</button>
            <button class="btn btn-secondary" @onclick="StartEdit">Edit</button>
            @* Same keyboard-reachable pattern as the upload button above. *@
            <label class="btn btn-secondary upload-trigger" for="media-replace">Replace file</label>
            <InputFile id="media-replace" class="visually-hidden" OnChange="HandleReplace" />
            <button class="btn btn-danger" @onclick="() => showConfirm = true">Delete</button>
        </div>
    </div>
}

@if (isEditing && selectedFile != null)
{
    <div class="settings-section media-edit">
        <h2 class="settings-section-title">Edit “@selectedFile.Title”</h2>
        <div class="form-group">
            <label class="form-label" for="media-edit-title">Title</label>
            <input id="media-edit-title" class="form-input" @bind="editTitle" />
            <FieldError Errors="fieldErrors" Field="title" InputId="media-edit-title" />
        </div>
        <div class="form-group">
            <label class="form-label" for="media-edit-slug">Path</label>
            <input id="media-edit-slug" class="form-input" @bind="editSlug" placeholder="docs/my-document.pdf"
                   aria-describedby="media-edit-slug-hint" />
            <p class="form-hint" id="media-edit-slug-hint">
                Currently served at @selectedFile.PublicPath. Letters, digits, “-”, “_”, “.” and “/”
                only; lower-cased. Leave empty to use the generated URL. Changing the path stops the
                old one working, so update any links to it.
            </p>
            <FieldError Errors="fieldErrors" Field="slug" InputId="media-edit-slug" />
        </div>
        <div class="media-detail-actions">
            <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
            <button class="btn btn-secondary" @onclick="() => isEditing = false">Cancel</button>
        </div>
    </div>
}

@if (isUploading)
{
    <div class="upload-progress">Uploading…</div>
}

<ConfirmDialog IsOpen="showConfirm"
    Title="Delete File"
    Message=@($"Delete \"{selectedFile?.Title}\"? This cannot be undone.")
    OnConfirm="DeleteSelected"
    OnCancel="() => showConfirm = false" />

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private PagedResult<MediaFileDto>? result;
    private MediaFileDto? selectedFile;
    private bool isLoading = true;
    private bool isUploading;
    private int currentPage = 1;
    private string searchQuery = "";
    private string errorMsg = "";
    private string successMsg = "";
    private bool showConfirm;
    private bool isEditing;
    private string editTitle = "";
    private string editSlug = "";
    private IReadOnlyDictionary<string, string>? fieldErrors;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        // Searched server-side. The old client-side filter only ever saw the 20 rows already
        // loaded, so a file that existed but sorted past the first page reported as missing.
        await LoadMedia(1);
    }

    protected override async Task OnInitializedAsync() => await LoadMedia(1);

    private async Task LoadMedia(int page)
    {
        isLoading = true;
        currentPage = page;
        errorMsg = "";
        // The selection belongs to the rows on screen; a different page or search would leave the
        // detail bar describing a file no longer visible.
        selectedFile = null;
        isEditing = false;
        try { result = await Api.GetMediaAsync(searchQuery, page); }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isLoading = false; }
    }

    private string RangeSummary()
    {
        if (result is null || result.Items.Count == 0) return "";
        var from = ((currentPage - 1) * result.PageSize) + 1;
        return $"{from}–{from + result.Items.Count - 1} of {result.TotalCount}";
    }

    private void SelectFile(MediaFileDto file)
    {
        selectedFile = selectedFile?.Id == file.Id ? null : file;
        isEditing = false;
    }

    private void StartEdit()
    {
        if (selectedFile == null) return;
        editTitle = selectedFile.Title;
        editSlug = selectedFile.Slug ?? "";
        fieldErrors = null;
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        if (selectedFile == null) return;
        errorMsg = "";
        fieldErrors = null;
        try
        {
            var updated = await Api.UpdateMediaAsync(selectedFile.Id, editTitle, editSlug);
            isEditing = false;
            successMsg = $"Saved. Now served at {updated?.PublicPath}";
            var id = selectedFile.Id;
            await LoadMedia(currentPage);
            selectedFile = result?.Items.FirstOrDefault(f => f.Id == id);
        }
        catch (ApiValidationException ex) { fieldErrors = ex.FieldErrors; }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private async Task HandleReplace(InputFileChangeEventArgs e)
    {
        if (selectedFile == null) return;
        isUploading = true;
        errorMsg = "";
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(maxAllowedSize: ContentLimits.MediaUploadBytes);
            await Api.ReplaceMediaAsync(selectedFile.Id, stream, file.Name, file.ContentType);
            successMsg = $"Content replaced with '{file.Name}'. The URL is unchanged.";
            var id = selectedFile.Id;
            await LoadMedia(currentPage);
            selectedFile = result?.Items.FirstOrDefault(f => f.Id == id);
        }
        catch (Exception ex) { errorMsg = $"Replace failed: {ex.Message}"; }
        finally { isUploading = false; }
    }

    private async Task HandleUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        errorMsg = "";
        try
        {
            var file = e.File;
            var title = Path.GetFileNameWithoutExtension(file.Name);
            // The same constant the server's default ceiling comes from. These were two separate
            // literals and they disagreed: this side allowed 50 MB while the server stopped at
            // Kestrel's 30 MB default, so a file in between uploaded and then failed.
            await using var stream = file.OpenReadStream(
                maxAllowedSize: ContentLimits.MediaUploadBytes);
            await Api.UploadMediaAsync(title, stream, file.Name, file.ContentType);
            successMsg = $"'{file.Name}' uploaded successfully.";
            // Page 1: the newest upload sorts to the top of the list, which is where the user
            // expects to find the file they just added.
            await LoadMedia(1);
        }
        catch (Exception ex) { errorMsg = $"Upload failed: {ex.Message}"; }
        finally { isUploading = false; }
    }

    /// <summary>
    /// Puts the file's URL on the clipboard. Used to only print it into a banner and call that
    /// done, while <c>blogitInterop.copyToClipboard</c> sat unused in interop.js.
    /// </summary>
    /// <remarks>
    /// Copies <c>PublicPath</c> as stored — server-relative, the same form the editor writes into
    /// a post (see PostEdit's media insert), so the pasted value works wherever the site is hosted.
    /// </remarks>
    private async Task CopyUrl()
    {
        if (selectedFile == null) return;
        errorMsg = "";
        try
        {
            await JS.InvokeVoidAsync("blogitInterop.copyToClipboard", selectedFile.PublicPath);
            successMsg = $"URL copied: {selectedFile.PublicPath}";
        }
        catch (JSException)
        {
            // navigator.clipboard is absent outside a secure context and the execCommand fallback
            // can be refused as well. Printing the URL is what this button did unconditionally
            // before; as a fallback it still leaves the operator something to select by hand.
            successMsg = $"Copy this URL manually: {selectedFile.PublicPath}";
        }
    }

    private async Task DeleteSelected()
    {
        showConfirm = false;
        if (selectedFile == null) return;
        try
        {
            await Api.DeleteMediaAsync(selectedFile.Id);
            // Drop back a page when that was the only file on the last one, so a delete cannot
            // leave the user staring at an empty grid.
            var page = result is { Items.Count: 1 } && currentPage > 1 ? currentPage - 1 : currentPage;
            await LoadMedia(page);
        }
        catch (Exception ex) { errorMsg = ex.Message; }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024):F1} MB"
    };
}
