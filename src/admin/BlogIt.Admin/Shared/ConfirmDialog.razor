@* No ✕ in the header: this dialog already has a labelled Cancel, and a second dismissal glyph beside
   it only adds a tab stop that says the same thing. *@
<ModalDialog IsOpen="IsOpen" Title="@Title" ExtraClass="modal-sm" ShowCloseButton="false" OnClose="HandleCancel">
    <div class="modal-body">
        <p>@Message</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="HandleConfirm">@ConfirmLabel</button>
    </div>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleConfirm() => await OnConfirm.InvokeAsync();

    // Escape and the overlay both land here, not on OnConfirm: dismissing a "this cannot be undone"
    // prompt has to mean no.
    private async Task HandleCancel() => await OnCancel.InvokeAsync();
}
