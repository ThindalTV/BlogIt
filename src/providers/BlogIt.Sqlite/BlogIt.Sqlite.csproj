<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlogIt.Sqlite</AssemblyName>
    <RootNamespace>BlogIt</RootNamespace>
    <PackageId>BlogIt.Sqlite</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>ThindalTV</Authors>
    <Description>SQLite database provider for BlogIt: a single-file database for small and self-hosted blogs, with a transitive dependency on the matching BlogIt engine package.</Description>
    <PackageTags>aspnetcore;blog;cms;sqlite</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Matches LICENSE.txt in the repository root; see src/BlogIt.Core/BlogIt.Core.csproj for why. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BlogIt.Core\BlogIt.Core.csproj" />
  </ItemGroup>

  <!--
    Pinned in lockstep with the EF Core version in BlogIt.Core.csproj: a provider one servicing
    patch ahead of or behind the EF Core runtime it plugs into is not a supported combination.
    Design is private and build-time only - it is what `dotnet ef migrations add` needs to generate
    this package's SQLite migrations, and nothing a consumer should restore.
  -->
  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="\" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Imported last so a Version or VersionPrefix set above is visible to it. See the file itself for
    why PackageVersion has to be plumbed into the assembly stamps by hand.
  -->
  <Import Project="..\..\..\build\BlogIt.Versioning.props" />

</Project>
