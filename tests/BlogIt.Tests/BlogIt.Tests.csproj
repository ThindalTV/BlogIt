<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Renders the Admin project's Razor components so the accessibility contract (label-to-input
      association, dialog role/aria-modal, keyboard-reachable controls) is asserted against real
      output instead of by reading the markup. 2.x rather than 1.40: the 1.x line pins AngleSharp
      1.2.0, which trips NU1902 and would put a warning into every build of this solution.
    -->
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced for its assembly only (Admin.Services types under test). Its own
         ProjectReference in BlogIt.csproj sets ReferenceOutputAssembly="false" because it wants
         the published wwwroot rather than the dll; here we want the opposite. -->
    <ProjectReference Include="..\..\src\BlogIt.Admin\BlogIt.Admin.csproj" />
    <ProjectReference Include="..\..\src\BlogIt.AzureStorage\BlogIt.AzureStorage.csproj" />
    <!--
      The AI and analytics satellites are referenced so their providers can be exercised against a
      real host, and so the compaction-policy tests can keep reaching OpenAiService's internals
      through InternalsVisibleTo. Referencing them here does not weaken the split: the assertion
      that a consumer never restores these SDKs is made in build/package-layout-tests/verify.ps1
      against a real package restore, not against this project.
    -->
    <ProjectReference Include="..\..\src\BlogIt.GoogleAnalytics\BlogIt.GoogleAnalytics.csproj" />
    <ProjectReference Include="..\..\src\BlogIt.OpenAi\BlogIt.OpenAi.csproj" />
    <ProjectReference Include="..\..\src\BlogIt\BlogIt.csproj" />
    <ProjectReference Include="..\..\src\BlogIt.Contracts\BlogIt.Contracts.csproj" />
    <ProjectReference Include="..\..\samples\BlogIt.Sample\BlogIt.Sample.csproj" />
  </ItemGroup>

</Project>