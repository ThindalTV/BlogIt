<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BlogItPackageVersion Condition="'$(BlogItPackageVersion)' == ''">0.0.1-local</BlogItPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Both AI and analytics satellites and no BlogIt reference: BlogIt must arrive transitively from
      each of them, exactly as it does for BlogIt.AzureStorage. One fixture covers both because the
      thing under test is the satellite mechanism, not the two SDKs.
    -->
    <PackageReference Include="BlogIt.GoogleAnalytics" Version="$(BlogItPackageVersion)" />
    <PackageReference Include="BlogIt.OpenAi" Version="$(BlogItPackageVersion)" />
  </ItemGroup>

</Project>
