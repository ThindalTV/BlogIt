<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlogItPackageVersion Condition="'$(BlogItPackageVersion)' == ''">0.0.1-local</BlogItPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlogIt" Version="$(BlogItPackageVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0-preview.*" />
  </ItemGroup>

</Project>
